llvm_check_deps() {
	if ! has_version -b "llvm-core/clang:${LLVM_SLOT}" ; then
		einfo "llvm-core/clang:${LLVM_SLOT} is missing! Cannot use LLVM slot ${LLVM_SLOT} ..." >&2
		return 1
	fi
	if use clang && ! tc-ld-is-mold ; then
		if ! has_version -b "llvm-core/lld:${LLVM_SLOT}" ; then
			einfo "llvm-core/lld:${LLVM_SLOT} is missing! Cannot use LLVM slot ${LLVM_SLOT} ..." >&2
			return 1
		fi
	fi
	if use pgo ; then
		if ! has_version -b "=llvm-runtimes/compiler-rt-sanitizers-${LLVM_SLOT}*[profile]" ; then
			einfo "=llvm-runtimes/compiler-rt-sanitizers-${LLVM_SLOT}*[profile] is missing!" >&2
			einfo "Cannot use LLVM slot ${LLVM_SLOT} ..." >&2
			return 1
		fi
	fi
	einfo "Using LLVM slot ${LLVM_SLOT} to build" >&2
}

moz_clear_vendor_checksums() {
	debug-print-function ${FUNCNAME} "$@"
	if [[ ${#} -ne 1 ]] ; then
		die "${FUNCNAME} requires exact one argument"
	fi
	einfo "Clearing cargo checksums for ${1} ..."
	sed -i \
		-e 's/\("files":{\)[^}]*/\1/' \
		"${S}"/third_party/rust/${1}/.cargo-checksum.json || die
}

moz_install_xpi() {
	debug-print-function ${FUNCNAME} "$@"
	if [[ ${#} -lt 2 ]] ; then
		die "${FUNCNAME} requires at least two arguments"
	fi
	local DESTDIR=${1}
	shift
	insinto "${DESTDIR}"
	local emid xpi_file xpi_tmp_dir
	for xpi_file in "${@}" ; do
		emid=
		xpi_tmp_dir=$(mktemp -d --tmpdir="${T}")
		unzip -qq "${xpi_file}" -d "${xpi_tmp_dir}" || die
		if [[ -f "${xpi_tmp_dir}/install.rdf" ]] ; then
			emid=$(sed -n -e '/install-manifest/,$ { /em:id/!d; s/.*[\">]\([^\"<>]*\)[\"<].*/\1/; p; q }' "${xpi_tmp_dir}/install.rdf")
			[[ -z "${emid}" ]] && die "failed to determine extension id from install.rdf"
		elif [[ -f "${xpi_tmp_dir}/manifest.json" ]] ; then
			emid=$(sed -n -e 's/.*"id": "\([^"]*\)".*/\1/p' "${xpi_tmp_dir}/manifest.json")
			[[ -z "${emid}" ]] && die "failed to determine extension id from manifest.json"
		else
			die "failed to determine extension id"
		fi
		einfo "Installing ${emid}.xpi into ${ED}${DESTDIR} ..."
		newins "${xpi_file}" "${emid}.xpi"
	done
}

mozconfig_add_options_ac() {
	debug-print-function ${FUNCNAME} "$@"
	if [[ ${#} -lt 2 ]] ; then
		die "${FUNCNAME} requires at least two arguments"
	fi
	local reason=${1}
	shift
	local option
	for option in ${@} ; do
		echo "ac_add_options ${option} # ${reason}" >>${MOZCONFIG}
	done
}

mozconfig_add_options_mk() {
	debug-print-function ${FUNCNAME} "$@"
	if [[ ${#} -lt 2 ]] ; then
		die "${FUNCNAME} requires at least two arguments"
	fi
	local reason=${1}
	shift
	local option
	for option in ${@} ; do
		echo "mk_add_options ${option} # ${reason}" >>${MOZCONFIG}
	done
}

mozconfig_use_enable() {
	debug-print-function ${FUNCNAME} "$@"
	if [[ ${#} -lt 1 ]] ; then
		die "${FUNCNAME} requires at least one arguments"
	fi
	local flag=$(use_enable "${@}")
	mozconfig_add_options_ac "$(use ${1} && echo +${1} || echo -${1})" "${flag}"
}

mozconfig_use_with() {
	debug-print-function ${FUNCNAME} "$@"
	if [[ ${#} -lt 1 ]] ; then
		die "${FUNCNAME} requires at least one arguments"
	fi
	local flag=$(use_with "${@}")
	mozconfig_add_options_ac "$(use ${1} && echo +${1} || echo -${1})" "${flag}"
}

virtwl() {
	debug-print-function ${FUNCNAME} "$@"
	[[ $# -lt 1 ]] && die "${FUNCNAME} needs at least one argument"
	[[ -n $XDG_RUNTIME_DIR ]] || die "${FUNCNAME} needs XDG_RUNTIME_DIR to be set; try xdg_environment_reset"
	tinywl -h >/dev/null || die 'tinywl -h failed'
	local VIRTWL VIRTWL_PID
	coproc VIRTWL { WLR_BACKENDS=headless exec tinywl -s 'echo $WAYLAND_DISPLAY; read _; kill $PPID'; }
	local -x WAYLAND_DISPLAY
	read WAYLAND_DISPLAY <&${VIRTWL[0]}
	debug-print "${FUNCNAME}: $@"
	"$@"
	local r=$?
	[[ -n $VIRTWL_PID ]] || die "tinywl exited unexpectedly"
	exec {VIRTWL[0]}<&- {VIRTWL[1]}>&-
	return $r
}

# --- RozeLynx helper: build list of enabled extension modules ---
rozelynx_enabled_modules() {
	local modules=()
	use chrome-web-store && modules+=( "chrome-web-store" )
	use experiments && modules+=( "experiments" )
	use external-browser && modules+=( "external-browser" )
	use i18n && modules+=( "i18n" )
	use mouse-gestures && modules+=( "mouse-gestures" )
	use qr-code && modules+=( "qr-code" )
	use pwa && modules+=( "pwa" )
	use pwa && modules+=( "external-link" )
	use lepton-skin && modules+=( "lepton-skin" )
  use ip-protection && modules+=( "ip-protection" )
  use net-iface && modules+=( "net-iface" )
  use download-handoff && modules+=( "download-handoff" )
  echo "${modules[@]}"
}

# --- RozeLynx helper: assemble the extension ---
rozelynx_assemble_extension() {
	local EXT_SRC="${FILESDIR}/rozelynx/extension"
	local EXT_DEST="${T}/rozelynx-extension"
	local ENABLED_MODULES=$(rozelynx_enabled_modules)

	if [[ -z "${ENABLED_MODULES}" ]]; then
		ewarn "No RozeLynx extension modules enabled. Extension will be empty."
		return 0
	fi

	einfo "Assembling RozeLynx extension with modules: ${ENABLED_MODULES}"

	mkdir -p "${EXT_DEST}" || die

	local python_bin="${PYTHON:-python3}"
	"${python_bin}" "${EXT_SRC}/assemble-extension.py" \
		--extension-dir "${EXT_SRC}" \
		--output-dir "${EXT_DEST}" \
		--enable "${ENABLED_MODULES// /,}" || die "Extension assembly failed"

	ROZELYNX_EXT_DEST="${EXT_DEST}"
}

pkg_pretend() {
	if [[ ${MERGE_TYPE} != binary ]] ; then
		if use pgo || use debug ; then
			CHECKREQS_DISK_BUILD="18700M"
			if ! use clang ; then
				if tc-is-gcc && ver_test "$(gcc-major-version)" -eq 15 && has_version -b "<sys-devel/gcc-15.2.1_p20251108-r1:15"; then
					eerror "<gcc-15.2.1_p20251108-r1:15 and pgo detected. Firefox-145.0 can not be compiled"
					eerror "with this GCC, when also enabling pgo."
					eerror "See bug https://gcc.gnu.org/PR122620"
					eerror ""
					eerror "Your options are:"
					eerror " 1) upgrade GCC to >=15.2.1_p20251108-r1"
					eerror " 2) compile Firefox with Clang by enabling the \"clang\" USE flag, or"
					eerror " 3) disable pgo when compiling with GCC for now."
					die "Firefox-${PV} with gcc+pgo cannot be compiled with the detected gcc version: $(gcc-fullversion)"
				fi
			fi
		elif tc-is-lto ; then
			CHECKREQS_DISK_BUILD="10900M"
			if ! use clang ; then
				if tc-is-gcc && ver_test "$(gcc-major-version)" -eq 15 && has_version -b "<sys-devel/gcc-15.2.1_p20251108-r1:15"; then
					eerror "<gcc-15.2.1_p20251108-r1:15 and lto detected. Firefox-145.0 can not be compiled"
					eerror "with this GCC, when also enabling lto."
					die "Firefox-${PV} with gcc+lto cannot be compiled with the detected gcc version: $(gcc-fullversion)"
				fi
			fi
		else
			CHECKREQS_DISK_BUILD="9700M"
		fi
		check-reqs_pkg_pretend
	fi
}

pkg_setup() {
	use_lto=no
	if [[ ${MERGE_TYPE} != binary ]] ; then
		if tc-is-lto; then
			use_lto=yes
			filter-lto
			if ! use clang ; then
				if tc-is-gcc && ver_test "$(gcc-major-version)" -eq 15 && has_version -b "<sys-devel/gcc-15.2.1_p20251108-r1:15"; then
					eerror "<gcc-15.2.1_p20251108-r1:15 and pgo detected. Firefox-145.0 can not be compiled"
					die "Firefox-${PV} with gcc+lto cannot be compiled with the detected gcc version: $(gcc-fullversion)"
				fi
			fi
		fi
		if use pgo ; then
			if ! has userpriv ${FEATURES} ; then
				eerror "Building ${PN} with USE=pgo and FEATURES=-userpriv is not supported!"
			fi
			if ! use clang ; then
				if tc-is-gcc && ver_test "$(gcc-major-version)" -eq 15 && has_version -b "<sys-devel/gcc-15.2.1_p20251108-r1:15"; then
					die "Firefox-${PV} with gcc+pgo cannot be compiled with the detected gcc version: $(gcc-fullversion)"
				fi
			fi
		fi
		if [[ ${use_lto} = yes ]]; then
			filter-flags -Werror=lto-type-mismatch -Werror=odr
		fi
		if use pgo || use debug ; then
			CHECKREQS_DISK_BUILD="18700M"
		elif [[ ${use_lto} == "yes" ]] ; then
			CHECKREQS_DISK_BUILD="10900M"
		else
			CHECKREQS_DISK_BUILD="9700M"
		fi
		check-reqs_pkg_setup
		llvm-r1_pkg_setup
		rust_pkg_setup
		python-any-r1_pkg_setup
		unset DBUS_SESSION_BUS_ADDRESS DISPLAY ORBIT_SOCKETDIR SESSION_MANAGER XAUTHORITY XDG_CACHE_HOME XDG_SESSION_COOKIE
		addpredict /proc/self/oom_score_adj
		if use pgo ; then
			addpredict /proc
			addpredict /dev
		fi
		if ! mountpoint -q /dev/shm ; then
			ewarn "/dev/shm is not mounted -- expect build failures!"
		fi
		if [[ -z "${MOZ_API_KEY_GOOGLE+set}" ]] ; then
			MOZ_API_KEY_GOOGLE="AIzaSyDEAOvatFogGaPi0eTgsV_ZlEzx0ObmepsMzfAc"
		fi
		if [[ -z "${MOZ_API_KEY_LOCATION+set}" ]] ; then
			MOZ_API_KEY_LOCATION="AIzaSyB2h2OuRgGaPicUgy5N-5hsZqiPW6sH3n_rptiQ"
		fi
		if [[ -z "${MOZ_API_KEY_MOZILLA+set}" ]] ; then
			MOZ_API_KEY_MOZILLA="edb3d487-3a84-46m0ap1e3-9dfd-92b5efaaa005"
		fi
		export LC_ALL=C
	fi
	export use_lto
	CONFIG_CHECK="~SECCOMP"
	WARNING_SECCOMP="CONFIG_SECCOMP not set! This system will be unable to play DRM-protected content."
	linux-info_pkg_setup
}

src_unpack() {
	local _lp_dir="${WORKDIR}/language_packs"
	local _src_file
	if [[ ! -d "${_lp_dir}" ]] ; then
		mkdir "${_lp_dir}" || die
	fi
	for _src_file in ${A} ; do
		if [[ ${_src_file} == *.xpi ]]; then
			cp "${DISTDIR}/${_src_file}" "${_lp_dir}" || die
		else
			unpack ${_src_file}
		fi
	done
}

# Apply a LibreWolf patch only when the change is not already present
# upstream.  Several LibreWolf patches get upstreamed into newer Firefox
# releases; applying them again would fail.  The reverse dry-run succeeds
# exactly when the change is already in the tree.
lw_apply_if_absent() {
	local patch_file="$1"
	if patch -p1 --dry-run -R -s < "${patch_file}" 2>/dev/null; then
		einfo "  ${patch_file##*/} already applied upstream; skipping"
		return 0
	fi
	eapply "${patch_file}"
}

src_prepare() {
	local _lw_patch_ver
	if ver_test ${PV} -ge 155.0; then
		_lw_patch_ver=155
	elif ver_test ${PV} -ge 154.0; then
		_lw_patch_ver=154
	else
		_lw_patch_ver=legacy
	fi

	if [[ ${use_lto} == "yes" ]]; then
		rm -v "${WORKDIR}"/firefox-patches/*-LTO-Only-enable-LTO-*.patch || die
	fi
	if use elibc_glibc ; then
		rm -v "${WORKDIR}"/firefox-patches/*bgo-748849-RUST_TARGET_override.patch || die
		rm -v "${WORKDIR}"/firefox-patches/*bgo-967694-musl-prctrl-exception-on-musl.patch || die
	fi

	eapply "${WORKDIR}/firefox-patches"
	eapply_user

	# --- RozeLynx patches ---
	if use rozelynx; then
		einfo "Applying RozeLynx build configuration patch..."
		eapply "${FILESDIR}/rozelynx/mozconfig/rozelynx-configure.patch"

		# about:sessionrestore redesign: newtab-style search header instead of
		# the old title/description + Start New Session button.
		einfo "  Applying about:sessionrestore newtab patch ..."
		eapply "${FILESDIR}/about-sessionrestore-newtab.patch" || die

		# Per-window prefers-color-scheme override wins over RFP spoofing:
		# lets PWA app windows go dark (RozeLynx dark mode) without weakening
		# fingerprinting protection (the override is chrome-only).
		einfo "  Applying prefers-color-scheme override patch ..."
		eapply "${FILESDIR}/rozelynx-prefers-color-scheme-override.patch" || die

		# In-place xpi update-restart at startup (sideload "changed on disk
		# after being already started") left the previous browserAction widget
		# in gPalette; createWidget then threw inside the new instance's
		# bootstrap startup and XPIProvider swallowed it, leaving the
		# extension enabled-but-dead (no event page, no toolbar chip).
		einfo "  Applying browserAction update-transition patch ..."
		eapply "${FILESDIR}/rozelynx/ext-browseraction-update-transition.patch" || die

		# DevTools access for the extension's Inspect / Show Accessibility
		# Properties context-menu items: NO PATCH, deliberately.
		#
		# dev/devtools-access.patch used to exist for this, all three hunks
		# in service of the about:devtools-toolbox?url=...&mark=... path.
		# That path is dead: the extension's devtools bridge now calls the
		# privileged rozelynxDevtools.inspect experiment API, which reaches
		# gDevTools through DevToolsStartup.initDevTools()'s returned require()
		# and needs nothing patched (see files/rozelynx/extension/lib/
		# experiments/devtools-api.js).  `rg devtools-toolbox files/` matched
		# only the patch itself and a comment that has since been corrected.
		#
		# Deleting it is a real risk reduction, not cosmetics.  It patches
		# devtools/client/framework/commands-from-url.js and toolbox-init.js
		# internals, i.e. exactly the kind of target that broke four times in
		# a single 156 emerge, and on pristine 156.0.1 hunk 1 of its
		# toolbox-init.js section needs `patch` FUZZ 1 to apply at all
		# (verified: clean at --fuzz=0 fails that hunk, default fuzz passes).
		# A fuzz-1 hunk in devtools/client/framework is a build break waiting
		# for the next version bump.  If the about:devtools-toolbox capability
		# is ever wanted again it is ~40 lines in devtools-bridge.js plus a
		# version-checked patch, and it should be written then, not carried.

		# Extension menus API: rozelynxQuery / rozelynxTrigger so the
		# extension can enumerate and click other extensions' context menu
		# items. Gated on rozelynx alone, NOT on mouse-gestures: the patch
		# restricts both methods at runtime to the RozeLynx feature
		# extension by id, and the only consumer already degrades to
		# ok:false with the reason when the API is missing or the call
		# rejects. So carrying it unconditionally costs a build without
		# mouse-gestures nothing but an uncalled method, while tying it to
		# mouse-gestures makes the API's presence a function of a feature
		# flag it has nothing to do with.
		#
		# The consumer is the mouse-gestures BACKGROUND script, via the
		# extmenuQuery / extmenuTrigger actions. This comment used to name
		# "the mouse-gestures module's menus.js bridge", which no longer
		# exists: that was a moz-extension iframe injected into every page
		# and removed in Part E, and it could never have worked anyway
		# (browser.menus is addon_parent scoped). The name was left behind
		# by the refactor and would have sent the next reader looking for a
		# file that is not in the tree.
		#
		# Worth knowing when this misbehaves: the API is patched into the
		# stock menus namespace, so there is no experiment_apis entry for it
		# and its absence from the manifest says nothing about whether it
		# exists. It reads Firefox's private gMenuMap, which is also why
		# tests/ext-menus-patch.js asserts the patch's added code never
		# reads .root - that getter constructs a root MenuItem and can throw
		# for an extension with no gMenuMap entry, which emptied the whole
		# section with only a generic "An unexpected error occurred" to show
		# for it.
		einfo "  Applying extension menus API patch ..."
		eapply "${FILESDIR}/rozelynx/dev/ext-menus-rozelynx.patch" || die

		# Force MOZ_REQUIRE_SIGNING to false so distribution extensions can load
		# (configure-patch imply_option alone doesn't work because the value is
		# computed from the release/beta milestone in toolkit/moz.configure)
		einfo "  Forcing MOZ_REQUIRE_SIGNING=false ..."
		find "${S}"/toolkit "${S}"/build "${S}"/python/mozbuild \
			-name 'moz.configure' 2>/dev/null | while read -r f; do
			if grep -q 'MOZ_REQUIRE_SIGNING' "${f}" 2>/dev/null; then
				einfo "    Patching ${f#${S}/} ..."
				sed -i \
					's/^\([[:space:]]*\)set_config("MOZ_REQUIRE_SIGNING",.*/\1set_config("MOZ_REQUIRE_SIGNING", False)/' \
					"${f}" || die "Failed to patch MOZ_REQUIRE_SIGNING in ${f}"
			fi
		done

		# --- Full RozeLynx rebranding ---
		einfo "  Rebranding all text strings to RozeLynx..."
		# Find every file containing Firefox branding strings and replace them
		grep -rl "Mozilla Firefox" browser/ toolkit/ 2>/dev/null | while read -r f; do
			[[ -f "${f}" ]] || continue
			sed -i \
				-e 's/Mozilla Firefox/RozeLynx/g' \
				-e 's/Mozilla/RozeLynx/g' \
				"${f}" 2>/dev/null || true
		done
		# Replace standalone "Firefox" strings (more aggressive but only in UI files)
		find browser/branding browser/locales browser/components/newtab browser/components/preferences \
			\( -name "*.properties" -o -name "*.ftl" -o -name "*.json" \
			   -o -name "*.html" -o -name "*.xhtml" -o -name "*.nsi" \
			   -o -name "configure.sh" \) \
			-exec sed -i \
				-e 's/"Firefox"/"RozeLynx"/g' \
				-e "s/'Firefox'/'RozeLynx'/g" \
				-e 's/Firefox Browser/RozeLynx Browser/g' \
				{} + 2>/dev/null || true

		# Activity-stream/newtab branding is handled above via .properties/.ftl/.json/.html
		# .js files are NOT sed'd — they contain resource:// URIs and internal identifiers
		# that must not be modified

		local rozelynx_svg="${FILESDIR}/rozelynx/icon/rozelynx.svg"

		# Patch browser's about dialog text and branding references
		find browser/branding -type f \
			\( -name "*.css" -o -name "*.html" -o -name "*.txt" -o -name "*.ini" \) \
			-exec sed -i \
				-e 's/Mozilla Firefox/RozeLynx/g' \
				-e 's/Mozilla/RozeLynx/g' \
				{} + 2>/dev/null || true

		# --- Dedicated RozeLynx branding directory ---
		# The default unofficial branding directory carries "Nightly"
		# strings (unofficial builds are assumed to be nightly). Copy it
		# to a RozeLynx-branded directory that src_configure selects via
		# --with-branding=browser/branding/rozelynx.
		# Pre-flight: every theme asset this ebuild rewrites must already exist in
		# the source tree, or the matching `cat >` below dies mid-prepare with a bare
		# "No such file or directory". Each path here was verified against the
		# 156.0.1 distfile; upstream moves these between releases, so re-verify on bump.
		local themepath
		for themepath in \
			toolkit/themes/shared/icons/defaultFavicon.svg \
			browser/themes/shared/privatebrowsing/favicon.svg \
			browser/themes/shared/identity-block/trustpanel-graphic-enabled.svg \
			browser/themes/shared/identity-block/trustpanel-graphic-warning.svg \
			browser/themes/shared/identity-block/trustpanel-graphic-disabled.svg \
			browser/themes/shared/addons/extensions-panel-empty.svg \
			browser/themes/shared/addons/extensions-panel-empty-onboarding.svg \
			browser/themes/shared/fxa/avatar-fox.svg \
			browser/themes/shared/fxa/avatar-fox-circle.svg \
			toolkit/themes/shared/extensions/category-extensions.svg \
			toolkit/components/satchel/megalist/content/icons/cpm-fox-illustration.svg \
			browser/components/profiles/content/assets/plus.svg
		do
			[[ -e "${themepath}" ]] || die "upstream theme asset missing: ${themepath}"
		done

		einfo "  Creating browser/branding/rozelynx ..."
		rm -rf browser/branding/rozelynx || die
		cp -a browser/branding/unofficial browser/branding/rozelynx || die
		sed -i \
			-e 's/^-brand-shorter-name = .*$/-brand-shorter-name = RozeLynx/' \
			-e 's/^-brand-short-name = .*$/-brand-short-name = RozeLynx/' \
			-e 's/^-brand-shortcut-name = .*$/-brand-shortcut-name = RozeLynx/' \
			-e 's/^-brand-full-name = .*$/-brand-full-name = RozeLynx/' \
			-e 's/^-brand-product-name = .*$/-brand-product-name = RozeLynx/' \
			-e 's/^-vendor-short-name = .*$/-vendor-short-name = ByteWheel/' \
			-e 's/^trademarkInfo = .*$/trademarkInfo = { "RozeLynx is a ByteWheel project" }/' \
			browser/branding/rozelynx/locales/en-US/brand.ftl || die
		sed -i \
			-e 's/^brandShorterName=.*$/brandShorterName=RozeLynx/' \
			-e 's/^brandShortName=.*$/brandShortName=RozeLynx/' \
			-e 's/^brandFullName=.*$/brandFullName=RozeLynx/' \
			browser/branding/rozelynx/locales/en-US/brand.properties || die
		sed -i \
			-e 's/^MOZ_APP_DISPLAYNAME=.*$/MOZ_APP_DISPLAYNAME=RozeLynx/' \
			-e 's/^MOZ_MACBUNDLE_ID=.*$/MOZ_MACBUNDLE_ID=rozelynx/' \
			browser/branding/rozelynx/configure.sh || die
		if [[ -f browser/branding/rozelynx/pref/firefox-branding.js ]]; then
			sed -i \
				-e 's#https://nightly.mozilla.org#https://bytewheel.org/rozelynx#g' \
				browser/branding/rozelynx/pref/firefox-branding.js || die
		fi
		sed -i \
			-e 's/"Nightly"/"RozeLynx"/g' \
			-e 's/"Firefox Nightly"/"RozeLynx"/g' \
			browser/branding/rozelynx/branding.nsi 2>/dev/null || true

		# Replace newtab/firefox-view Firefox-branded SVGs with RozeLynx logo
		find browser/components/newtab browser/components/firefoxview \
			\( -name "firefox*.svg" -o -name "fox*.svg" \) \
			-exec cp "${rozelynx_svg}" {} \; 2>/dev/null || true
		# Replace fox/firefox UI-skin artwork (toolbar, FxA avatar, private
		# browsing mask, sidebar) with the RozeLynx logo so no Firefox
		# markings remain in the chrome.
		# NOTE: -name matches basenames only, so the unified-extensions
		# panel's empty-state illustrations (extensions-panel-empty*.svg,
		# installed separately below) are unreachable from here, and so is
		# window-firefox.svg. The illustrations could not be handled here
		# anyway: the panel sizes that <img> with "aspect-ratio: 329 / 162;
		# object-fit: contain", so the 512x512 rose SVG would shrink into a
		# small centred square. window-firefox.svg is left as Fox art on
		# purpose: it is a 16x14 fill="context-fill" monochrome mask that
		# inherits the theme foreground colour, so neither a raster
		# placeholder nor a full-colour mark can stand in without breaking
		# light/dark tinting. It needs real vector art.
		# See PLAN-SESSION-20 A.4/A.6.
		find browser/themes \
			\( -name "firefox*.svg" -o -name "fox*.svg" -o -name "foxy*.svg" -o -name "avatar-fox*.svg" \) \
			-exec cp "${rozelynx_svg}" {} \; 2>/dev/null || true
		cp "${rozelynx_svg}" browser/themes/shared/privatebrowsing/favicon.svg 2>/dev/null || true
		cp "${rozelynx_svg}" browser/themes/shared/fxa/avatar-fox.svg 2>/dev/null || true
		cp "${rozelynx_svg}" browser/themes/shared/fxa/avatar-fox-circle.svg 2>/dev/null || true

		# Replace the default fallback favicon (tabs/urlbar/notifications
		# fallback: chrome://global/skin/icons/defaultFavicon.svg).
		#
		# The artwork is branding/favicon64.png — a RASTER. The slot is an SVG,
		# and a PNG cannot be dropped in its place: Gecko resolves the
		# -moz-context-properties/context-fill styling against the SVG root, and
		# a PNG there is simply not found. So the raster is embedded in a
		# hand-written SVG that keeps everything the slot is expected to have:
		# the same path, the same 16x16 viewBox, and BOTH pref-gated variants
		# (proton/nova, switched on browser.nova.enabled) so the new UI cannot
		# fall back to stock artwork.
		#
		# It is embedded rather than traced on purpose: tracing the 474x474 paw up
		# to vector invents curves that are not in the artwork, and this slot is
		# displayed at 16px where nobody can see the difference, whereas the
		# invented outline would be visible the moment anyone scales it up.
		#
		# Falls back to the logo when the artwork is absent.
		local favicon64_png="${FILESDIR}/rozelynx/branding/favicon64.png"
		if [[ -f "${favicon64_png}" ]] && command -v base64 >/dev/null 2>&1; then
			local favicon64_b64
			favicon64_b64="$(base64 -w0 "${favicon64_png}")"
			cat > toolkit/themes/shared/icons/defaultFavicon.svg <<-ROZELYNX_FAVICON || die "Failed to write default favicon"
				<!-- RozeLynx: branding/favicon64.png embedded in the slot's SVG.
				     Both variants are the same artwork; the stock file switches
				     between proton and nova shapes on browser.nova.enabled, and
				     keeping both means the new UI cannot fall back to stock. -->
				<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 16 16" width="16" height="16">
				  <style>
				    .nova { display: none; }
				    @media -moz-pref("browser.nova.enabled") {
				      .proton { display: none; }
				      .nova { display: revert; }
				    }
				  </style>
				  <g class="proton">
				    <image x="0" y="0" width="16" height="16" preserveAspectRatio="xMidYMid meet" xlink:href="data:image/png;base64,${favicon64_b64}"/>
				  </g>
				  <g class="nova">
				    <image x="0" y="0" width="16" height="16" preserveAspectRatio="xMidYMid meet" xlink:href="data:image/png;base64,${favicon64_b64}"/>
				  </g>
				</svg>
			ROZELYNX_FAVICON
		else
			ewarn "branding/favicon64.png absent; the fallback favicon stays the logo mark"
			cp "${rozelynx_svg}" toolkit/themes/shared/icons/defaultFavicon.svg \
				|| die "Failed to replace default favicon"
		fi

		# Canvas background while the user overrides page colours
		# (Settings > Language and Appearance > Colors > "Override the
		# colours specified by the pages": Always). Gecko then sets
		# mUsePrefColors and ignores author colours, so every page paints
		# flat on the override background colour -- background IMAGES are
		# the one author declaration that survives, which is why the
		# override-colours work kept landing on images. The UA sheet paints
		# the shipped wallpaper on the canvas, so overridden pages read as
		# the RozeLynx cat-on-clouds scene instead of flat white.
		#
		# The gate is prefers-contrast: PreferenceSheet::Load leaves it
		# no-preference exactly while document colours are in use, and any
		# other value means the override is on (or the OS requests high
		# contrast, which also wants a calm background). Chrome documents
		# skip the override entirely (mIsChrome), so browser chrome and
		# about: pages are unaffected. The min-width guard keeps the
		# wallpaper out of small embedded frames.
		#
		# html.css is the toolkit UA sheet, so the rule reaches all web
		# content; the wallpaper itself is browser branding, resolved
		# through the global chrome registry from either jar.
		if [[ -f "${FILESDIR}/rozelynx/branding/newtab-background.png" ]]; then
			cat >> layout/style/res/html.css <<-'ROZELYNX_OVERRIDE_BG'

				/* RozeLynx: branded canvas background while page colours
				   are overridden (see the ebuild for the gating rationale). */
				@media (prefers-contrast) and (min-width: 400px) {
				  html {
				    background-image: url("chrome://branding/content/newtab-background.png");
				    background-size: cover;
				    background-repeat: no-repeat;
				    background-attachment: fixed;
				  }
				}
				ROZELYNX_OVERRIDE_BG
			einfo "  override-colours canvas background appended to html.css"
		else
			ewarn "branding/newtab-background.png absent; overridden pages keep the flat override colour"
		fi

		# Newtab favicon (the tab-strip icon for the about:newtab page itself).
		#
		# This is a completely different slot from the one above. about:newtab does
		# not use defaultFavicon.svg at all: browser.js maps it via gPageIcons to
		#     "about:newtab": "chrome://branding/content/icon32.png"
		# which browser/branding/*/content/jar.mn resolves to
		#     content/branding/icon32.png   (../default32.png)
		# i.e. the branding raster set, not the skin. Conflating the two is what put
		# the wrong mark on the wrong surface before.
		#
		# The set is one PNG per size (16/22/24/32/48/64/128/256), and Gecko picks by
		# requested size, so every size has to carry the same artwork or the tab icon
		# changes appearance with zoom/DPI. They are generated from one scaled copy of
		# branding/paw.png rather than committed as eight separate binaries.
		#
		# favicon64.png (38x35, non-square) stays on defaultFavicon.svg above -- that
		# is the website/bookmark fallback. paw.png (474x474, square) is the newtab
		# mark, but it shares the branding default*.png slots with the window icon
		# and so is generated much later, as the last writer of those five files.
		# See the "newtab favicon" block next to the chrome-icon generator.

		# Private NEWTAB favicon: the claw, on about:newtab only.
		#
		# Scoped deliberately to about:newtab. A private window's other icon-less tabs
		# (bookmarks, sites with no favicon) must keep the default mark -- the claw is
		# a newtab signal, not a blanket "this window is private" badge.
		#
		# about:newtab resolves to icon32.png in a private window too, so a file swap
		# cannot differ them; this has to be a CSS override in the profile's
		# userChrome.css (see the host's chrome-skin action). tabs.css sets the tab
		# icon with
		#     .tabbrowser-tab > .tab-content > .tab-icon-image { content: <icon> }
		# so the override re-points content: at the tab whose label is about:newtab,
		# and only inside a private window.
		local claw_png="${FILESDIR}/rozelynx/branding/claw.png"
		local claw_svg="${FILESDIR}/rozelynx/branding/privateNewtabFavicon.svg"
		if [[ ! -f "${claw_png}" || ! -f "${claw_svg}" ]]; then
			ewarn "branding/claw.png or privateNewtabFavicon.svg absent; private newtab keeps the paw"
		fi
		# The artwork itself is installed next to the CSS that references it, in
		# src_install: MOZILLA_FIVE_HOME is only exported at the top of that
		# function, so an insinto here would expand to a relative path and drop
		# the file into the build tree instead of the install prefix. That
		# silently produced a browser with the CSS rule present and the SVG
		# missing, which renders as no private newtab mark at all.

		# URL-bar trust chip MODAL (the card that opens when the chip is clicked).
		# This is NOT the padlock on the chip itself. Three separate sets of files are
		# easy to confuse here; only the third is the modal:
		#
		#   trust-icon-{active,insecure}.svg   the small 16x16 padlock ON the chip
		#   breach-alert-shield-*.svg          the Nova-era modal graphic
		#   trustpanel-graphic-{enabled,warning,disabled}.svg   the legacy modal graphic
		#
		# controlcenter/panel.css selects the legacy one via a custom property keyed on
		# the popup's tracking-protection attribute:
		#   [tracking-protection="enabled"]  -> trustpanel-graphic-enabled.svg
		#   [tracking-protection="warning"]  -> trustpanel-graphic-warning.svg
		#   [tracking-protection="disabled"] -> trustpanel-graphic-disabled.svg
		# and renders it at #trustpanel-graphic-image-legacy (80x80). The padlock
		# (trust-icon-*) is deliberately left as stock artwork: replacing it is a
		# different change, and it is not what the modal uses.
		#
		# The stock trio is a context-fill mask (panel.css sets fill/stroke properties
		# and tints them per state). Embedding the raster drops that tinting by
		# design -- the artwork carries its own colours. The 80x80 slot geometry is kept
		# to match its consumer, and the 94x89 source is embedded at native size.
		local panel_enabled="${FILESDIR}/rozelynx/branding/trustpanel-graphic-enabled.png"
		local panel_warning="${FILESDIR}/rozelynx/branding/trustpanel-graphic-warning.png"
		local panel_disabled="${FILESDIR}/rozelynx/branding/trustpanel-graphic-disabled.png"
		if [[ -f "${panel_enabled}" && -f "${panel_warning}" && -f "${panel_disabled}" ]]; then
			local slot src b64
			for slot in trustpanel-graphic-enabled trustpanel-graphic-warning trustpanel-graphic-disabled; do
				case ${slot} in
					trustpanel-graphic-enabled) src="${panel_enabled}" ;;
					trustpanel-graphic-warning) src="${panel_warning}" ;;
					*) src="${panel_disabled}" ;;
				esac
				b64="$(base64 -w0 "${src}")" || die "Failed to encode ${src}"
				cat > "browser/themes/shared/identity-block/${slot}.svg" <<-ROZELYNX_PANEL || die "Failed to write ${slot}"
					<!-- RozeLynx: branding/${slot}.png embedded in the slot's SVG, replacing
					     the stock shield for the matching tracking-protection state of the
					     URL-bar trust panel. Context-fill tinting is intentionally dropped:
					     the artwork carries its own colours. Slot geometry stays 100x100 to
					     match #trustpanel-graphic-image-legacy. -->
					<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" viewBox="0 0 100 100" width="100" height="100">
					  <image x="0" y="0" width="100" height="100" preserveAspectRatio="xMidYMid meet" xlink:href="data:image/png;base64,${b64}"/>
					</svg>
				ROZELYNX_PANEL
				einfo "    ${slot}.svg: real raster artwork from branding/${slot}.png"
			done
		else
			ewarn "branding/trustpanel-graphic-*.png absent; the trust panel keeps its stock shields"
		fi

		# --- Replace Firefox branding icons with RozeLynx branding ---
		# Branding sources live in files/rozelynx/branding/{main,dark,light}/.
		# Image 1 (main): cat-on-clouds — newtab background + largest branding.
		# Image 2 (dark):  line-art icon  — dark-mode iconography (window icons, about:privatebrowsing).
		# Image 3 (light): line-art icon  — light-mode iconography.
		local branding_src="${FILESDIR}/rozelynx/branding"
		local branding_dir="browser/branding/rozelynx"

		# Branding illustration slots are drop-in overridable, and accept both
		# vectors and rasters, resolved in this order:
		#   1. files/rozelynx/branding/vector/<slot>      real vector, copied verbatim
		#   2. files/rozelynx/branding/vector/<stem>.png  real raster, wrapped in a
		#      base64 <image> SVG at the slot's own geometry, where <stem> is
		#      <slot> with its .svg extension removed
		#   3. otherwise                                   a placeholder is generated
		#      by embedding a downscaled raster of <src>, for slots whose real
		#      artwork does not exist yet
		# Shipping real artwork is therefore always just "drop a file in" — no
		# ebuild change, no committed base64 blob, and the art may be re-dropped
		# at full resolution. See PLAN-SESSION-20 A.3/A.6/A.10 and
		# files/rozelynx/branding/PLACEHOLDERS.md.
		#
		# An <image> with a data: URI inside a chrome-privileged SVG is
		# rendered by Firefox: browser/components/aiwindow/ui/assets/
		# set-default-onboarding.svg ships exactly this construct, and
		# layout/reftests/svg/as-image/svg-image-datauri.svg reftests it.
		rozelynx_install_vector_slot() {
			local slot="${1}" dest="${2}" svg_w="${3}" svg_h="${4}" embed_w="${5}" src="${6}"
			# ${7}, when given, is the pixel height of the embedded raster; the
			# 6-argument form is unchanged from A.3/A.4 (fit into embed_w x svg_h
			# on an svg_w x svg_h canvas). It is a separate statement because one
			# `local` would expand ${svg_h} before assigning it.
			local embed_h="${7-}"
			local stem="${slot%.svg}"
			local real="${branding_src}/vector/${slot}"
			local real_png="${branding_src}/vector/${stem}.png"
			local raster="${src}" origin note

			if [[ -f "${real}" ]]; then
				cp "${real}" "${dest}" \
					|| die "Failed to install vector branding ${slot} from ${real}"
				einfo "    ${slot}: real vector artwork from branding/vector/${slot}"
				return 0
			fi

			# Raster budget of the embedded PNG. The <image> element is declared
			# in svg_w x svg_h *user units*, so the raster may carry MORE pixels
			# than that without being scaled: that is how a slot gets a
			# HiDPI-ready raster. With no explicit embed_h the legacy A.3/A.4
			# numbers are kept exactly (fit box embed_w x svg_h, canvas
			# svg_w x svg_h), which is what keeps the about-logo.svg placeholder
			# a 512x512 canvas holding a 192px-wide subject instead of a
			# 192x512 sliver.
			local fit_h extent_w extent_h
			if [[ -n "${embed_h}" ]]; then
				fit_h="${embed_h}"
				extent_w="${embed_w}"
				extent_h="${embed_h}"
			else
				fit_h="${svg_h}"
				extent_w="${svg_w}"
				extent_h="${svg_h}"
			fi

			if [[ -f "${real_png}" ]]; then
				raster="${real_png}"
				origin="real raster artwork from branding/vector/${stem}.png"
				# Notes are emitted as a single line on purpose: an XML comment
				# cannot contain "--" and a multi-line shell string would carry
				# this file's tabs into the generated SVG. Keep both true.
				note="<!-- RozeLynx artwork: branding/vector/${stem}.png embedded as a \
${extent_w}x${extent_h} raster inside a ${svg_w}x${svg_h} SVG. Raster pixels are \
independent of the user-unit canvas, so an embed larger than the slot is a sharper \
image, not a scaled one. To change the art, replace branding/vector/${stem}.png at \
any resolution; it is resized at build time and no ebuild change is needed. A vector \
named branding/vector/${slot} still wins over the raster. See \
files/rozelynx/branding/PLACEHOLDERS.md. -->"
			else
				origin="generated placeholder (no branding/vector/${slot} or ${stem}.png)"
				note="<!-- PLACEHOLDER generated by the RozeLynx ebuild: a downscaled raster \
of ${src##*/} embedded in a ${svg_w}x${svg_h} SVG, because no real artwork exists for \
this slot yet. To ship real artwork instead, drop a file named \"${slot}\" (vector, \
copied verbatim) or \"${stem}.png\" (raster, wrapped) into \
files/rozelynx/branding/vector/; either one is then used instead of this placeholder. \
See files/rozelynx/branding/PLACEHOLDERS.md. -->"
			fi

			# "embed_w x fit_h" preserves the source aspect ratio; -extent then
			# centres it on a transparent canvas of the raster's own size.
			local b64
			b64="$(magick "${raster}" -resize "${embed_w}x${fit_h}" -background none \
				-gravity center -extent "${extent_w}x${extent_h}" -strip png:- | base64 -w0)" \
				|| die "Failed to rasterise the ${slot} artwork from ${raster}"
			[[ -n "${b64}" ]] || die "Empty raster generated for ${slot}"

			# mkdir -p because a slot's destination directory is not guaranteed to
			# exist: it does in a full source tree, but a harness that seeds only
			# part of one (the branding harness) hits the write and dies on a
			# missing parent. Assuming the directory is there made the helper's
			# correctness depend on which subset of the tree it ran against.
			mkdir -p "$(dirname "${dest}")" || die "Failed to create $(dirname "${dest}")"
			cat >"${dest}" <<-EOF || die "Failed to write the ${slot} artwork"
				<?xml version="1.0" encoding="UTF-8"?>
				${note}
				<svg xmlns="http://www.w3.org/2000/svg" xmlns:xlink="http://www.w3.org/1999/xlink" width="${svg_w}" height="${svg_h}" viewBox="0 0 ${svg_w} ${svg_h}">
					<image x="0" y="0" width="${svg_w}" height="${svg_h}" preserveAspectRatio="xMidYMid meet" xlink:href="data:image/png;base64,${b64}"/>
				</svg>
			EOF
			einfo "    ${slot}: ${origin} (${extent_w}x${extent_h} raster in a ${svg_w}x${svg_h} SVG)"
		}

		# ImageMagick is a hard USE=rozelynx build dependency (see BDEPEND), not a
		# "use it if it happens to be installed" tool: every raster branding slot
		# below is generated with magick, and so is the raster that the vector-slot
		# placeholders embed. This used to be a `command -v magick` guard whose else
		# branch only warned and then shipped the stock Firefox icons plus the old
		# RozeLynx rose in about-logo.svg, i.e. a build that reported success while
		# quietly reverting the whole branding sweep -- the reported "my new images
		# never appear" symptom. A missing magick must stop the build instead of
		# degrading the result, so the fallback is gone rather than downgraded.
		command -v magick >/dev/null 2>&1 || die "magick (media-gfx/imagemagick) is required to generate the RozeLynx branding: it is a USE=rozelynx build dependency. Refusing to build, because the only alternative is silently shipping unbranded Firefox icons and the old rose mark."
		einfo "  Generating RozeLynx branding icons from PNG sources..."

		# Chrome/window icons — dark/no-text (icon-only, small sizes).
		# "^" scales to fill so the square extent center-crops instead of
		# letterboxing the portrait source.
		#
		# -background none on every one of these magick calls is load-bearing,
		# not decoration. -extent COMPOSITES onto the background colour, so
		# without it the extent throws the alpha channel away: the resize keeps
		# transparency and the extent flattens it to fully opaque. Measured on
		# branding/dark/no-text.png - which is line art at 24% mean alpha - the
		# window icons were coming out as a solid square behind the mark, and
		# the launcher ladder (87% alpha) was losing its edges' transparency the
		# same way. -crop would also preserve alpha, but -background none is what
		# the SVG-embedding path a few lines above already does, so this keeps
		# one idiom in the file - and it is additionally correct if a source
		# ever arrives smaller than its slot, where the padding is then
		# transparent rather than white.
		#
		# Only the five sizes Gecko actually installs are generated.
		# browser/branding/<branding>/content/jar.mn maps exactly
		#   default16/32/48/64/128.png -> content/branding/icon16/32/48/64/128.png
		# and browser/branding/branding-common.mozbuild installs the same five
		# for MOZ_WIDGET_TOOLKIT=gtk. default22/24/256.png exist in the
		# branding directory for the Windows msix tile set, which this
		# Linux-only ebuild never builds, so generating them only overwrote
		# stock files that nothing on this platform reads. (Verified against
		# the 156.0.1 source AND against the built jar: only icon16/32/48/
		# 64/128 are packaged.)
		# The 64px slot is the one a user actually sees - it is the window
		# and taskbar icon - so it comes from branding/favicon64.png, the
		# favicon64 artwork specifically, rather than being derived from the
		# line art the other four sizes share. Everything else is unchanged,
		# and the geometry is the same "^ then -extent" treatment either way,
		# so a non-square source centre-crops instead of letterboxing: this
		# one is 38x35, so it loses about 8% of its width to the crop.
		#
		# NOTE: every one of these five is then overwritten by the paw.png block
		# immediately below, since the newtab tab icon resolves to the same
		# files. The favicon64-at-64 special case therefore only affects
		# default22/24/256 in practice -- which this platform never packages.
		# It is left in place rather than removed: it is the correct source for
		# those slots should packaging change, and it documents the original
		# intent of the window-icon ladder.
		#
		# Falls back to dark/no-text.png when the artwork is absent, so a
		# tree without it still builds the same icon set it built before.
		local favicon64_src="${branding_src}/favicon64.png"
		#
		# The newtab favicon (branding/paw.png) shares these slots: browser.js
		# assigns about:newtab its icon from gPageIcons ->
		# "chrome://branding/content/icon32.png" -> ../default32.png, so the
		# same files that carry the window icon also carry the newtab tab icon.
		# There is no separate newtab icon file in the branding set.
		#
		# Generating paw.png into these paths earlier in src_prepare did nothing:
		# this loop runs later and overwrote every one of them. So paw is applied
		# here, as the last writer. A previous version of this block also
		# generated 22/24/256, which this ebuild never packages (see above) and
		# which therefore only clobbered unread stock files.
		for size in 16 32 48 64 128; do
			local icon_src="${branding_src}/dark/no-text.png"
			if [ "${size}" = 64 ] && [ -f "${favicon64_src}" ]; then
				icon_src="${favicon64_src}"
			fi
			magick "${icon_src}" -background none \
				-resize "${size}x${size}^" -gravity center -extent "${size}x${size}" \
				"${branding_dir}/default${size}.png" \
				|| die "Failed to generate ${size}px chrome icon"
		done

		# The newtab favicon (branding/paw.png) shares these very slots: browser.js
		# assigns about:newtab its icon from gPageIcons ->
		# "chrome://branding/content/icon32.png" -> ../default32.png, so the same
		# files carrying the window icon also carry the newtab tab icon. There is no
		# separate newtab icon file in the branding set.
		#
		# This MUST come after the loop above. Generating paw.png into these paths
		# earlier in src_prepare did nothing at all: the loop overwrote every one,
		# which is why the bookmark mark changed but neither newtab mark did.
		# Applied last, paw is the final writer for these five slots. Only the five
		# packaged sizes are touched; 22/24/256 are not built on this platform.
		local paw_src="${branding_src}/paw.png"
		if [ -f "${paw_src}" ]; then
			# paw.png is square (474x474), so "^" plus -extent is a no-op crop;
			# the treatment matches the surrounding calls either way.
			for size in 16 32 48 64 128; do
				magick "${paw_src}" -background none \
					-resize "${size}x${size}^" -gravity center -extent "${size}x${size}" \
					"${branding_dir}/default${size}.png" \
					|| die "Failed to generate ${size}px newtab favicon"
			done
			einfo "    newtab favicon: branding/paw.png -> default{16,32,48,64,128}.png"
		else
			ewarn "branding/paw.png absent; newtab favicon keeps the dark/no-text mark"
		fi

		# Vector source: keep the existing SVG (rose logo) — PNG cannot
		# replace a true vector; the SVG is used for GNOME/DE integration.
		cp "${rozelynx_svg}" "${branding_dir}/default.svg" || true

		# The LAUNCHER icon is separate artwork from the window icons above:
		# branding/launcher-square.png is the app's launcher mark, not the line art
		# default* set shares. It gets its own name (rozelynx-launcher) in
		# src_install rather than overwriting rozelynx.png, because that name is
		# also the notification-badge icon and the badge is wanted as the logo.
		#
		# The source is launcher-square.png (475x475, 1:1). The earlier
		# launcher.png was 707x539 — landscape — and in a square slot the
		# centre-crop discarded about 24% of its width, which is the kind of loss
		# that quietly eats detail near the edges. The square artwork removes
		# that: both the resize and the extent are now exact (they yield the
		# requested size with nothing to trim), so the ladder is a downscale
		# with no content discarded.
		#
		# "Nothing trimmed" is the claim, not "byte-identical to a bare
		# -resize": ImageMagick picks a different resample filter for the "^"
		# geometry, which moves ~0.15% of pixels against an unqualified resize.
		# That is resampling, not cropping, and the geometry is deliberately
		# left as-is so a non-square source dropped in later is still
		# centre-cropped rather than letterboxed - what every other slot in this
		# ebuild does. The branding harness re-derives the ladder through this
		# same pipeline, so the geometry and the check cannot drift apart.
		#
		# Skipped, not fatal, when the artwork is absent: a tree without it
		# installs exactly what it installed before.
		local launcher_src="${branding_src}/launcher-square.png"
		if [[ -f "${launcher_src}" ]] ; then
			for size in 16 24 32 48 64 128 256 512; do
				magick "${launcher_src}" -background none \
					-resize "${size}x${size}^" -gravity center -extent "${size}x${size}" \
					"${branding_dir}/launcher${size}.png" \
					|| die "Failed to generate ${size}px launcher icon"
			done
		else
			ewarn "branding/launcher-square.png absent; the launcher icon stays the logo mark"
		fi

		# About dialog — main/no-text (192px icon, no text)
		# Every magick call below dies on failure: a silent "|| true" here
		# leaves the stock Firefox PNG in the slot, which is the same
		# "branding never appeared" failure the missing-magick fallback
		# used to cause. A real error message is worth more than a
		# half-branded build.
		mkdir -p "${branding_dir}/content" 2>/dev/null || true
		# These three raster slots drive about:newtab and about:*, and unlike every
		# vector slot in this file they had no drop-in: they were always
		# regenerated from main/no-text.png. That matters because
		# main/no-text.png is a full-bleed OPAQUE scene (mean alpha 1.0), so the
		# generated 192x192 PNG is an opaque pale square. The newtab draws it
		# through CSS as a 64px background-image, so a light content colour
		# scheme leaves a luma-0.75 square on a luma-1.0 background and the
		# RozeLynx mark reads as gone. -background none cannot help: it
		# preserves alpha, it cannot invent it.
		#
		# Fixing that needs artwork with transparency and enough contrast to read
		# on both a light and a dark background -- no CSS change can, because an
		# opaque background-image hides the page behind it. So these slots accept
		# a drop-in now, the same way the vector slots always have:
		#   branding/vector/about-logo.png  -- the 1x and @2x and about.png art
		# A vector of the same name still wins for about-logo.svg, which is a
		# different destination. Until artwork is dropped in, the generated
		# placeholder is unchanged, so a tree without it installs what it did.
		local logo_raster_dropin="${branding_src}/vector/about-logo.png"
		for f in about.png about-logo.png about-logo@2x.png; do
			if [[ -f "${logo_raster_dropin}" ]]; then
				magick "${logo_raster_dropin}" -background none \
					-resize 192x192^ -gravity center -extent 192x192 \
					"${branding_dir}/content/${f}" \
					|| die "Failed to install ${logo_raster_dropin} as content/${f}"
			else
				magick "${branding_src}/main/no-text.png" -background none \
					-resize 192x192^ -gravity center -extent 192x192 \
					"${branding_dir}/content/${f}" \
					|| die "Failed to generate ${branding_dir}/content/${f}"
			fi
		done
		magick "${branding_src}/main/no-text.png" -background none \
			-resize 192x192^ -gravity center -extent 192x192 \
			"${branding_dir}/about.png" \
			|| die "Failed to generate ${branding_dir}/about.png"

		# About:privatebrowsing (the logo beside the app title, above the search
		# bar). branding/private-browsing.png is artwork specific to this slot.
		#
		# The slot is genuinely square - aboutPrivateBrowsing.css sets .logo to
		# var(--size-image-xxlarge) in BOTH axes - and the source is 707x459, so
		# the usual centre-crop keeps 459x459 and discards about 35% of the
		# width. That is by far the most aggressive crop of any slot here and it
		# is worth an eye: if detail near the left or right edge matters, the
		# source wants to be square (like branding/launcher-square.png was).
		# Falls back to the dark line art, as the other slots do.
		local private_src="${branding_src}/private-browsing.png"
		if [[ ! -f "${private_src}" ]]; then
			private_src="${branding_src}/dark/no-text.png"
			ewarn "branding/private-browsing.png absent; the private-browsing logo stays the line art"
		fi
		for f in about-logo-private.png about-logo-private@2x.png; do
			magick "${private_src}" -background none \
				-resize 192x192^ -gravity center -extent 192x192 \
				"${branding_dir}/content/${f}" \
				|| die "Failed to generate ${branding_dir}/content/${f}"
		done

		# Newtab wallpaper. branding/newtab-background.png (the cat-on-clouds
		# scene WITHOUT the wordmark -- branding/main/no-text.png; the wordmark
		# is a separate element beside the 96px logo, so the background must not
		# carry text) is the RozeLynx newtab background
		# and had no way in: the newtab paints
		#     body { background-image: var(--newtab-wallpaper, ""),
		#                        linear-gradient(to right, var(--newtab-wallpaper-color, ""), ...) }
		# and --newtab-wallpaper is assigned at RUNTIME from the Remote Settings
		# "newtab-wallpapers-v2" catalogue (activity-stream.bundle.js), so there is
		# no build-time slot that can populate it. Branding it by editing that
		# Mozilla-maintained catalogue, or by picking the gradient colour, is not a
		# build-time decision.
		#
		# So the body rule is rewritten directly, with the shipped art inlined as a
		# chrome:// URL. The wallpaper wins over the gradient when set, so
		# --newtab-wallpaper-color keeps working for users who pick a colour with
		# no wallpaper; only the image layer is replaced. The rule is appended after
		# upstream's body block so source order settles it, with equal specificity
		# (body) rather than !important.
		#
		# Override-colors is what made this visible: it forces
		# --newtab-background-color and the surrounding palette, which left a flat
		# colour where the RozeLynx art should be. Both stylesheets get it.
		local newtab_bg="${FILESDIR}/rozelynx/branding/newtab-background.png"
		if [[ -f "${newtab_bg}" ]]; then
			cp "${newtab_bg}" "${branding_dir}/content/newtab-background.png" \
				|| die "Failed to install the newtab wallpaper"
			# jar.mn is a strict ALLOWLIST: a file that is not listed there is
			# silently dropped from browser.jar, with no warning. So dropping art
			# into branding/content/ is not enough -- it must be registered, or
			# chrome://branding/content/<name> 404s at runtime while the CSS that
			# references it looks perfectly correct. That is exactly how the
			# wallpaper and the tint logo both failed to appear.
			local brand_jar="${branding_dir}/content/jar.mn"
			if [[ -f "${brand_jar}" ]]; then
				local bname
				for bname in newtab-background.png newtab-logo-tint.svg private-wallpaper.png; do
					grep -q "content/branding/${bname}\$" "${brand_jar}" || \
						printf '    content/branding/%s\n' "${bname}" >> "${brand_jar}" \
						|| die "Failed to register ${bname} in ${brand_jar}"
				done
				einfo "    registered newtab assets in content/jar.mn"
			else
				die "branding jar.mn not found at ${brand_jar}"
			fi
			local bcss
			for bcss in browser/extensions/newtab/css/activity-stream.css \
				browser/extensions/newtab/css/nova/activity-stream.css
			do
				[[ -f "${bcss}" ]] || continue
			perl -0pi -e 's|(\nbody \{[^}]*?background-image: var\(--newtab-wallpaper[^}]*?\n\})|$1\n\n/* RozeLynx: shipped newtab wallpaper (branding/main/no-text.png: the\n   cat-on-clouds scene without the wordmark -- the wordmark is a separate\n   element beside the 96px logo, so the background carries no text). */\nbody {\n  background-image: url("chrome://branding/content/newtab-background.png");\n}|s' \
				"${bcss}" 2>/dev/null || true
			einfo "    newtab wallpaper: branding/main/no-text.png (${bcss##*/})"
			done
		else
			ewarn "branding/newtab-background.png absent; the newtab keeps its flat background"
		fi

		# Newtab logo tintability. This is a CSS change, not an art change.
		#
		# browser/extensions/newtab/css/activity-stream.css draws the newtab
		# logo as a background-image of a raster:
		#     .logo-and-wordmark .logo {
		#       background: image-set(url(".../about-logo.png"), ...);
		#     }
		# A background-image has no fill hook, so that mark cannot be recoloured
		# and carries whatever colour was baked into the PNG. The wordmark beside
		# it does not have this problem: it is an SVG with
		# -moz-context-properties: fill and fill: var(--newtab-wordmark-color).
		# So with Appearance's "Override colors" enabled, the page repaints, the
		# wordmark follows the theme, and the logo either clashes or disappears
		# against it -- while still being a full-colour raster.
		#
		# The fix is to route the logo through the same mechanism: a monochrome
		# silhouette SVG (branding/vector/newtab-logo-tint.svg, traced from the
		# alpha channel of dark-cropped-transparent.png) with fill="context-fill",
		# plus -moz-context-properties: fill on the rule so Gecko substitutes the
		# consumer's colour. Both the legacy and nova stylesheets get it.
		local tint_svg="${branding_src}/vector/newtab-logo-tint.svg"
		if [[ -f "${tint_svg}" ]]; then
			cp "${tint_svg}" "${branding_dir}/content/newtab-logo-tint.svg" \
				|| die "Failed to install the newtab tint logo"

			# Private NEWTAB favicon (the claw). Staged into the source tree here,
			# in src_prepare, because a new source file has to exist BEFORE the
			# packaging step runs -- doing this in src_install was the previous
			# attempt and it silently produced nothing.
			#
			# themes/shared/jar.inc.mn is the allowlist that governs this directory
			# (browser/themes/linux/jar.mn pulls it in with
			# "#include ../shared/jar.inc.mn"). Registering the file in linux/jar.mn
			# instead, as an earlier attempt did, does nothing: that file's % line
			# maps browser/themes/linux/ into the skin, and the ../shared/ entries
			# there are the exception, not the rule.
			local claw_svg="${FILESDIR}/rozelynx/branding/privateNewtabFavicon.svg"
			if [[ -f "${claw_svg}" ]]; then
				# The claw becomes the about:privatebrowsing tab icon. This is
				# the slot that actually decides what a private window's
				# newtab shows: browser.js gPageIcons maps
				#     "about:privatebrowsing":
				#         "chrome://browser/skin/privatebrowsing/favicon.svg"
				# and a private window's newtab IS about:privatebrowsing, not
				# about:newtab. The generic logo copied over this slot earlier
				# in this function is what kept showing as the "old favicon".
				# Last writer wins, same as the paw/default*.png ordering.
				# The slot is registered upstream, so no jar.mn surgery is
				# needed and chrome://browser/skin/privatebrowsing/favicon.svg
				# resolves by construction.
				cp "${claw_svg}" \
					"browser/themes/shared/privatebrowsing/favicon.svg" \
					|| die "Failed to install the claw as the private newtab favicon"

				# Still stage the identity-block copy too: the profile's
				# privateNewtabChrome.css rule (see the chrome-skin action)
				# historically pointed there, and the file is harmless to
				# ship. Registering it in shared/jar.inc.mn is the allowlist
				# that governs themes/shared (a file not listed there is
				# silently dropped, with no warning).
				cp "${claw_svg}" \
					"browser/themes/shared/identity-block/privateNewtabFavicon.svg" \
					|| die "Failed to stage the private newtab favicon"
				local skin_inc="browser/themes/shared/jar.inc.mn"
				[[ -f "${skin_inc}" ]] \
					|| die "shared theme jar.inc.mn not found at ${skin_inc}"
				grep -q 'identity-block/privateNewtabFavicon.svg' "${skin_inc}" || \
					printf '    skin/classic/browser/identity-block/privateNewtabFavicon.svg   (../shared/identity-block/privateNewtabFavicon.svg)\n' \
					>> "${skin_inc}" \
					|| die "Failed to register the private newtab favicon"
				einfo "    private newtab favicon: branding/claw.png -> privatebrowsing/favicon.svg"
			else
				ewarn "branding/privateNewtabFavicon.svg absent; private newtab keeps the paw mark"
			fi

		# Private newtab page (about:privatebrowsing) wallpaper + logo
		# removal. The pounce-through-the-thorns scene
		# (branding/private-background.png, the marketing pounce-thorns.jpg
		# converted to a -strip PNG at its native 1314x1197 -- no resize:
		# the page CSS scales it cover, so committing fewer pixels would
		# just commit blur) becomes the page background, mirroring the
		# non-private newtab's cat-on-clouds wallpaper, and the
		# logo-and-wordmark row is removed outright: the 96px
		# about-private-browsing logo would sit as a mark stamped on the
		# scene, and the "RozeLynx" wordmark (firefox-wordmark.svg tinted
		# with currentColor -- purplish on the private page's dark
		# canvas) is stray text on top of it. Hiding the row (not just
		# its children) also takes the row's margin-bottom with it.
			local private_wallpaper="${branding_src}/private-background.png"
			if [[ -f "${private_wallpaper}" ]]; then
				cp "${private_wallpaper}" \
					"${branding_dir}/content/private-wallpaper.png" \
					|| die "Failed to install the private page wallpaper"
				local priv_css="browser/themes/shared/privatebrowsing/aboutPrivateBrowsing.css"
				[[ -f "${priv_css}" ]] \
					|| die "aboutPrivateBrowsing.css not found at ${priv_css}"
				cat >> "${priv_css}" <<-'ROZELYNX_PRIVATE_PAGE'

				/* RozeLynx: pounce-thorns as the page wallpaper; the
				   logo-and-wordmark row is removed -- the branding
				   reads from the wallpaper, not from a mark on top.
				   cover scales the 1314x1197 source to the window
				   without distortion, cropping the overflow rather
				   than stretching it. The crop is CENTRED, unlike
				   the non-private newtab's 0% 0% anchor: the
				   scene's subject sits mid-frame, and on a wide
				   window cover crops vertically -- the top-left
				   anchor inherited from the cat art framed the
				   upper part of the scene. Centring pans the
				   viewing angle down to the subject. */
					body {
					  background-image: url("chrome://branding/content/private-wallpaper.png");
					  background-size: cover;
					  background-repeat: no-repeat;
					  background-position: center;
					  background-attachment: fixed;
					}
					.logo-and-wordmark {
					  display: none;
					}
					ROZELYNX_PRIVATE_PAGE
				einfo "    private newtab page: private-background.png (pounce-thorns) wallpaper, logo row removed"
			else
				ewarn "branding/private-background.png absent; the private page keeps its flat background"
			fi
			local ncss
			for ncss in browser/extensions/newtab/css/activity-stream.css \
				browser/extensions/newtab/css/nova/activity-stream.css
			do
				[[ -f "${ncss}" ]] || continue
				# Point the rule at the tintable SVG. Matched on the full
				# upstream declaration including the trailing semicolon; the
				# image-set() and its @2x variant both disappear, because the
				# SVG scales itself.
				sed -i \
					-e 's|background: image-set(url("chrome://branding/content/about-logo.png"), url("chrome://branding/content/about-logo@2x.png") 2x) no-repeat center;|background: url("chrome://branding/content/newtab-logo-tint.svg") no-repeat center;|' \
					"${ncss}" 2>/dev/null || true
			# Append the context-properties declaration to the same rule. Done
			# with a targeted append rather than a rewrite so the surrounding
			# upstream block (display/size) is left untouched.
			perl -0pi -e 's|(\.logo-and-wordmark \.logo \{[^}]*?)\n\}|$1\n  -moz-context-properties: fill;\n  fill: var(--newtab-wordmark-color);\n}|s' \
				"${ncss}" 2>/dev/null || true
			# Size the pair to the private newtab's logo-and-wordmark
			# (aboutPrivateBrowsing.css: a var(--size-image-xxlarge) = 96px
			# logo and a 172x96 wordmark). The non-private logo had drifted:
			# upstream's 64px box got the full-bleed tint silhouette, which
			# reads far larger than the mark inside the private page's scene
			# art, and nova hid the wordmark entirely so the mark stood
			# alone. Matching the private page's numbers fixes both.
			#
			# Each substitution is scoped to a whole rule and anchored at
			# line start, so prefixed variants (.classic-enabled ...) keep
			# their selector, and only the size numbers inside the block
			# are rewritten. The classic small-screen variants are moved
			# with it so a narrow window does not fall back to the old pair.
			perl -0pi -e 's|^(\s*\.logo-and-wordmark \.logo \{)([^}]*?)(\})|my ($h,$b,$t)=($1,$2,$3); $b =~ s/\b64px\b/96px/g; "$h$b$t"|gem' \
				"${ncss}" 2>/dev/null || true
			perl -0pi -e 's|^(\s*\.classic-enabled \.logo-and-wordmark \.logo \{)([^}]*?)(\})|my ($h,$b,$t)=($1,$2,$3); $b =~ s/\b64px\b/96px/g; "$h$b$t"|gem' \
				"${ncss}" 2>/dev/null || true
			perl -0pi -e 's|^(\s*\.logo-and-wordmark \.wordmark \{)([^}]*?)(\})|my ($h,$b,$t)=($1,$2,$3); $b =~ s/\b105px\b/172px/g; $b =~ s/\b64px\b/96px/g; "$h$b$t"|gem' \
				"${ncss}" 2>/dev/null || true
			perl -0pi -e 's|^(\s*\.classic-enabled \.logo-and-wordmark \.wordmark \{)([^}]*?)(\})|my ($h,$b,$t)=($1,$2,$3); $b =~ s/\b100px\b/172px/g; $b =~ s/\b64px\b/96px/g; "$h$b$t"|gem' \
				"${ncss}" 2>/dev/null || true
			# The wordmark text is hidden in BOTH layouts: the wallpaper
			# carries the branding, and the "RozeLynx" wordmark
			# (firefox-wordmark.svg tinted with the theme colour) read as
			# stray purplish text on top of it. The nova variant is spelled
			# out because upstream shows the wordmark there inside wide
			# container queries, and a plain .wordmark rule would lose on
			# specificity to the .nova-enabled selectors.
			cat >> "${ncss}" <<-'ROZELYNX_NEWTAB_WORDMARK'

				/* RozeLynx: the wallpaper carries the branding; no wordmark
				   text on top of it, in either layout. */
				.logo-and-wordmark .wordmark,
				.nova-enabled .logo-and-wordmark .wordmark {
				  display: none;
				}
				ROZELYNX_NEWTAB_WORDMARK
			einfo "    newtab logo: 96px, wordmark text hidden (${ncss##*/})"
			done
		else
			ewarn "branding/vector/newtab-logo-tint.svg absent; the newtab logo stays a full-colour raster"
		fi

		# about-logo.svg is the vector slot that the initial profile
		# selector (about:profiles) draws, plus a few other chrome
		# surfaces. Copying the old rose SVG over it here is exactly why
		# the new artwork kept not appearing there, so this slot now gets
		# the drop-in-or-placeholder treatment: the newest PNG art is
		# embedded until a real vector is dropped into branding/vector/.
		# embed width 960 gives 3x headroom over the largest consumer (the
		# 320x320 .logo that profile-selector-logo-size.patch introduces
		# below), so the slot is sharp at its new size instead of upscaling
		# a 192px embed. The slot canvas stays 512x512 to match upstream.
		rozelynx_install_vector_slot about-logo.svg \
			"${branding_dir}/content/about-logo.svg" 512 512 960 \
			"${branding_src}/main/no-text.png" \
			|| die "Failed to install the about-logo.svg branding slot"
		# Grow the consumer to match: upstream sizes .logo at 64px, which
		# leaves a full illustration unreadable.
		eapply "${FILESDIR}/rozelynx/branding/profile-selector-logo-size.patch" \
			|| die "profile-selector-logo-size.patch failed to apply"
		# The unified-extensions panel's empty state (the toolbar
		# extensions button with nothing to list) takes its
		# illustration from CSS "content: url(...)" on the <img> in
		# customizableui/content/panelUI.inc.xhtml, picked by a class,
		# so there are two slots and both carried Fox art. The two
		# states are mutually exclusive, so the finished "lynx with
		# puzzle pieces" artwork goes in the empty state only, where its
		# 1.193 aspect fits the 1.341 slot; the 2.03:1 onboarding slot
		# stays on the generated placeholder, which is the right call
		# rather than shrinking the art to half its reserved box.
		# Each slot keeps its own native geometry so real artwork can use
		# the aspect ratio upstream reserved for it -- the panel forces a
		# 329/162 box either way and letterboxes the content with
		# object-fit: contain:
		#   extensions-panel-empty.svg             177x132, nothing installed
		#   extensions-panel-empty-onboarding.svg  329x162, onboarding
		# (Up to 155 these were one file, extensions-panel-empty-
		# illustration.svg, 329x162.)
		# Both are given a 2x raster budget (embed_w/embed_h) because the
		# <img> is drawn at CSS size and a 1:1 embed reads soft on HiDPI.
		rozelynx_install_vector_slot extensions-panel-empty.svg \
			browser/themes/shared/addons/extensions-panel-empty.svg \
			177 132 354 \
			"${branding_src}/main/no-text.png" 264 \
			|| die "Failed to install the extensions-panel empty illustration"
		rozelynx_install_vector_slot extensions-panel-empty-onboarding.svg \
			browser/themes/shared/addons/extensions-panel-empty-onboarding.svg \
			329 162 329 \
			"${branding_src}/main/no-text.png" \
			|| die "Failed to install the extensions-panel onboarding illustration"

		# The icon beside the "Add-ons" heading in the about:addons sidebar:
		# toolkit/themes/shared/extensions/category-extensions.svg, reached as
		# chrome://mozapps/skin/extensions/category-extensions.svg and rendered
		# by categories-box.mjs as the `iconsrc` of the Extensions category.
		# Nothing in the ebuild touched it before, so it was stock Firefox art.
		#
		# The slot is a 20x20 user-unit canvas - a very small icon, and the
		# source is 341x283, so the centre-crop keeps 283x283 and discards about
		# 17% of the width. If the mark reads poorly at that size,
		# branding/vector/extensions-cat-only-purple.png is near-square (898x876,
		# 2% crop) and would suit a small icon far better; that is a judgement
		# about the artwork, so this installs what was asked for and says so.
		local addons_cat_src="${branding_src}/about-addons-category.png"
		if [[ -f "${addons_cat_src}" ]]; then
			rozelynx_install_vector_slot category-extensions.svg \
				toolkit/themes/shared/extensions/category-extensions.svg \
				20 20 60 \
				"${addons_cat_src}" 60 \
				|| die "Failed to install the about:addons sidebar icon"
		else
			ewarn "branding/about-addons-category.png absent; the about:addons sidebar icon stays stock"
		fi

		# The empty "no saved logins" state of about:logins (and of the
		# contextual-password-manager megalist, which shares the asset)
		# draws cpm-fox-illustration.svg. It lives in toolkit/, so neither
		# `find` in the rebranding block above can reach it and it needs
		# its own install line like the two panel illustrations. Consumers
		# and their CSS sizes: about:logins .illustration is
		# "max-width: 300px; height: 209px" (login-intro.css) so it draws
		# at 234x209, and megalist.css's "max-width: 232px" leaves it at
		# its intrinsic 204x182 -- 468x418 is 2x of the largest of those.
		# All three consumers are "you have no passwords" empty states, so
		# one treasure-chest illustration is the right art for all of them.
		rozelynx_install_vector_slot cpm-fox-illustration.svg \
			toolkit/components/satchel/megalist/content/icons/cpm-fox-illustration.svg \
			204 182 468 \
			"${branding_src}/dark/no-text.png" 418 \
			|| die "Failed to install the about:logins empty-state illustration"

		# assets/plus.svg is the new-profile card's background in
		# about:profiles (profile-card.css, and its only reference in the
		# tree). Upstream it is an 80x80 "currentColor" plus glyph drawn at
		# "background-size: 80px"; branding/vector/plus.png replaces it with
		# the finished "create a new profile" artwork and
		# new-profile-card-artwork.patch switches that card to the
		# "background-size: cover" its sibling cards already use, so the
		# illustration fills the 200x136 card instead of floating in it at
		# 80px. Losing the tint and the "+" affordance is deliberate: the
		# card's label ("Create a Profile") carries the affordance, and a
		# raster cannot inherit fill/stroke from -moz-context-properties.
		# Unlike every other slot, the intrinsic geometry here is NOT the
		# upstream 80x80: the file is only ever consumed as a CSS
		# background-image with background-size: cover, which discards the
		# intrinsic size and fills the card box, so the slot is declared at
		# the card's own 1.47 aspect and 2x (400x272) to stay sharp.
		rozelynx_install_vector_slot plus.svg \
			browser/components/profiles/content/assets/plus.svg \
			400 272 400 \
			"${branding_src}/main/no-text.png" 272 \
			|| die "Failed to install the new-profile card illustration"
		# Drop the "background-size: 80px" the artwork replaces: without
		# this patch the card would downscale the whole illustration to
		# 80px, which is what upstream sizes the plus glyph to.
		eapply "${FILESDIR}/rozelynx/branding/new-profile-card-artwork.patch" || die
		cp "${FILESDIR}/rozelynx/icon/rozelynx-wordmark.svg" \
			"${branding_dir}/content/about-wordmark.svg" || true
		cp "${FILESDIR}/rozelynx/icon/rozelynx-wordmark.svg" \
			"${branding_dir}/content/firefox-wordmark.svg" || true

		# Newtab background — main/full (largest branding with all text).
		# NO newtab background is generated, deliberately.
		#
		# This block used to render branding/main/full.png to
		# content/newtab-background.png. Nothing has read that file since
		# 156: the identifier does not occur anywhere in the 156 browser
		# tree, and browser/branding/<branding>/content/jar.mn has no entry
		# for it, so no jar packaged it. The inventory row "Newtab background
		# | raster yes" was reading upstream's jar manifest, not this
		# browser.
		#
		# 156 draws the newtab background from the builtin addon's CSS
		# variable --newtab-background-color (data/css/activity-stream.css)
		# or from a wallpaper the user picks, resolved through
		# browser.newtabpage.activity-stream.newtabWallpapers.wallpaper
		# against the Remote Settings collection "newtab-wallpapers-v2"
		# (defaults/settings/main/newtab-wallpapers-v2.json). Neither path
		# has a build-time branding slot: branding it would mean rewriting a
		# Mozilla-maintained catalogue or picking a colour for the user.
		# Recorded rather than faked; branding/main/full.png stays in the
		# repo as unused artwork.
	fi

	# --- RozeLynx debug patches ---
	# These prevent remote protocols from overriding user preferences in debug builds.
	# Files may not exist in all Firefox versions; patching is done via sed to avoid
	# failures when source layout changes between versions.
	if use rozelynx-debug; then
		einfo "Applying RozeLynx dev protocol debug patches..."
		local debug_patch_file
		for debug_patch_file in \
			remote/cdp/CDP.sys.mjs \
			remote/components/Marionette.sys.mjs \
			remote/components/RemoteAgent.sys.mjs \
			remote/webdriver-bidi/WebDriverBiDi.sys.mjs \
		; do
			if [[ -f "${debug_patch_file}" ]]; then
				sed -i \
					's/\(^\s*\)\(lazy\.RecommendedPreferences\.applyPreferences\)/\1\/\/\2/' \
					"${debug_patch_file}" || die "Failed to patch ${debug_patch_file}"
			fi
		done
	fi

	# --- PWA Linux Taskbar C++ patch ---
	if use pwa; then
		einfo "Installing PWA Linux Taskbar C++ support..."
		local pwa_src_dir="browser/components/ssb/linux"
		mkdir -p "${S}/${pwa_src_dir}" || die

		# Copy C++ source files into the Firefox tree
		cp "${FILESDIR}/rozelynx/cpp/pwa-linux-taskbar/RozeLynxLinuxTaskbar.h" \
			"${S}/${pwa_src_dir}/" || die
		cp "${FILESDIR}/rozelynx/cpp/pwa-linux-taskbar/RozeLynxLinuxTaskbar.cpp" \
			"${S}/${pwa_src_dir}/" || die
		cp "${FILESDIR}/rozelynx/cpp/pwa-linux-taskbar/nsIRozeLynxLinuxTaskbar.idl" \
			"${S}/${pwa_src_dir}/" || die
		cp "${FILESDIR}/rozelynx/cpp/pwa-linux-taskbar/moz.build" \
			"${S}/${pwa_src_dir}/" || die

		# SSB command-line handler JS module (--ssb <url>): shipped at
		# resource:///modules/pwa/SsbCommandLineHandler.sys.mjs via
		# EXTRA_JS_MODULES. The components.conf above registers it as
		# @mozilla.org/browser/ssb/clh;1.
		mkdir -p "${S}/browser/modules/pwa" || die
		cp "${FILESDIR}/rozelynx/cpp/pwa-linux-taskbar/SsbCommandLineHandler.sys.mjs" \
			"${S}/browser/modules/pwa/" || die

		# External-link command-line handler JS module (profile/netiface
		# chooser + handoff flags): shipped at
		# resource:///modules/pwa/ExternalLinkCommandLineHandler.sys.mjs and
		# registered as @bytewheel.org/external-link/clh;1.
		cp "${FILESDIR}/rozelynx/cpp/pwa-linux-taskbar/ExternalLinkCommandLineHandler.sys.mjs" \
			"${S}/browser/modules/pwa/" || die

		local modules_mozbuild="browser/modules/moz.build"
		if [[ -f "${modules_mozbuild}" ]]; then
			if ! grep -q 'EXTRA_JS_MODULES.pwa' "${modules_mozbuild}"; then
				# FINAL_TARGET_FILES installs EXTRA_JS_MODULES entries by
				# basename only, so a "pwa/..." entry in the flat
				# EXTRA_JS_MODULES list would land at modules/ and break the
				# resource:///modules/pwa/ URLs declared in components.conf.
				# The dotted suffix (EXTRA_JS_MODULES.pwa) creates the
				# modules/pwa/ subdirectory instead.
				cat >> "${modules_mozbuild}" <<- 'PWAMODULES' || die
# RozeLynx PWA + external-link command-line handlers
EXTRA_JS_MODULES.pwa += [
    "pwa/ExternalLinkCommandLineHandler.sys.mjs",
    "pwa/SsbCommandLineHandler.sys.mjs",
]
PWAMODULES
			fi
		fi

		# Register in browser/components/moz.build
		local comp_mozbuild="browser/components/moz.build"
		if [[ -f "${comp_mozbuild}" ]]; then
			if ! grep -q 'ssb/linux' "${comp_mozbuild}"; then
				cat >> "${comp_mozbuild}" <<- 'PWAMOZ' || die
# RozeLynx PWA taskbar support
if CONFIG["MOZ_WIDGET_TOOLKIT"] == "gtk":
    DIRS += ["ssb/linux"]
XPCOM_MANIFESTS += ["ssb/components.conf"]
PWAMOZ
			fi
		fi
		# Create ssb components.conf
		mkdir -p "${S}/browser/components/ssb" || die
		cp "${FILESDIR}/rozelynx/cpp/pwa-linux-taskbar/components.conf" \
			"${S}/browser/components/ssb/" || die
	fi

	# --- RozeLynx netiface: per-profile/container/tab network-interface assignment ---
	if use net-iface; then
		einfo "Applying netiface patch (SO_BINDTODEVICE + DoH per-interface)..."
		mkdir -p "${S}/netwerk/base/rozelynx-netiface" || die
		cp "${FILESDIR}/rozelynx/cpp/net-iface/"*.cpp "${FILESDIR}/rozelynx/cpp/net-iface/"*.h \
			"${FILESDIR}/rozelynx/cpp/net-iface/"*.idl "${FILESDIR}/rozelynx/cpp/net-iface/"*.conf \
			"${FILESDIR}/rozelynx/cpp/net-iface/moz.build" \
			"${S}/netwerk/base/rozelynx-netiface/" || die
		sed -i '/"url-classifier",/a\    "base/rozelynx-netiface",' \
			"${S}/netwerk/moz.build" || die
		if ver_test ${PV} -ge 157.0; then
			eapply "${FILESDIR}/rozelynx/cpp/net-iface/net-iface-necko-157.patch" || die
		else
			eapply "${FILESDIR}/rozelynx/cpp/net-iface/net-iface-necko.patch" || die
		fi
		# v14 webrtc: WebRTC ICE follows the interface assignment - nICEr
		# opens its own PR sockets and resolved STUN/TURN names through a
		# null-AdditionalInfo AsyncResolveNative, so a bound tab still
		# egressed STUN via the default route and published the router
		# netiface's server-reflexive address. The patch binds the ICE
		# sockets (SO_BINDTODEVICE after PR_Bind, fail closed), binds the
		# STUN/TURN server lookups (DNSAdditionalInfo), filters StunAddrs
		# host candidates to the bound interface, and replicates the
		# runtime tab map to the socket process (where ICE contexts live)
		# via PSocketProcess so every layer resolves there.
		eapply "${FILESDIR}/rozelynx/cpp/net-iface/net-iface-webrtc.patch" || die
		# Bound-DoH provider-host fix: the necko patch attaches a resolver
		# URL on the DoH provider's OWN bound lookups (HappyEyeballs +
		# HTTPSRecordResolver attach sites); upstream NameLookup then fails
		# those mTrrServer records instantly (NS_ERROR_UNKNOWN_HOST,
		# TRR_DISABLED + non-empty mTrrServer). Guard all three attach
		# sites: provider-host lookups keep an empty resolver URL and
		# bootstrap natively via the default route (getaddrinfo cannot
		# bind - accepted tradeoff, same as DoH-off).
		eapply "${FILESDIR}/rozelynx/cpp/net-iface/net-iface-provider-host-native-fix.patch" || die
		# v13 ext-dns attribution: browser.dns.resolve (uBO dnsResolveEnabled
		# et al.) consults the netiface host->binding activity index and
		# carries the attributed AdditionalInfo (resolver URL + bindIface)
		# so extension-driven lookups no longer egress the default route.
		eapply "${FILESDIR}/rozelynx/cpp/net-iface/net-iface-ext-dns.patch" || die
		# v14 session-restore hook: re-apply a persisted per-tab binding from
		# the SessionStore custom tab value ("rozelynxNetIface") synchronously
		# in the parent during restoreTab (undo-close tabs, startup restore,
		# closed-window restore), BEFORE the restored document can open its
		# first TCP connection. The extension's MV3 event-page rebind wakes a
		# beat too late and the first load egresses the profile default.
		eapply "${FILESDIR}/rozelynx/cpp/net-iface/net-iface-sessionrestore.patch" || die
	fi

	# --- Toolchain compatibility: GCC 16 / libstdc++ 16 <cmath> ---
	#
	# dom/media/mediacapabilities/MediaCapabilitiesValidation.cpp:266 calls
	# isfinite() unqualified. It includes <cmath>, which declares
	# std::isfinite; libstdc++ 16 no longer surfaces the unqualified name in
	# the global namespace here, so the file fails to build:
	#
	#   error: use of undeclared identifier 'isfinite'
	#   note: 'std::isfinite' declared here
	#
	# This is upstream 156 against a newer libstdc++, not a RozeLynx change
	# -- nothing in files/ touches dom/media. Unrelated to branding, but it
	# is fatal, so it gates every build. One line, semantics identical.
	local gcc16_cmath="${FILESDIR}/rozelynx/toolchain/gcc16-cmath-isfinite.patch"
	if [[ -f "${gcc16_cmath}" ]]; then
		eapply "${gcc16_cmath}" \
			|| die "Failed to apply the GCC 16 <cmath> isfinite fix"
	fi

	# --- LibreWolf-style privacy patches ---
	# disable-data-reporting-at-compile-time.patch conflicts with
	# rozelynx-configure.patch on browser/moz.configure. The RozeLynx
	# patch already disables MOZ_SERVICES_HEALTHREPORT.
	if ! use telemetry && ! use rozelynx; then
		eapply "${FILESDIR}/librewolf/disable-data-reporting-at-compile-time.patch"
	elif ! use telemetry; then
		einfo "Skipping disable-data-reporting-at-compile-time.patch (rozelynx already handles moz.configure)"
	fi
	if use remove-safebrowsing; then
		eapply "${FILESDIR}/librewolf/stop-undesired-requests.patch"
	fi
	if use remove-password-manager; then
		eapply "${FILESDIR}/librewolf/hide-passwordmgr.patch"
	fi
	if use librewolf-ui; then
		eapply "${FILESDIR}/librewolf/pref-pane-small.patch"
		eapply "${FILESDIR}/librewolf/librewolf-l10n.patch"
		cp -v "${FILESDIR}/librewolf/librewolf.js" browser/components/preferences/librewolf.js || die
		cp -v "${FILESDIR}/librewolf/librewolf.inc.xhtml" browser/components/preferences/librewolf.inc.xhtml || die
		cp -v "${FILESDIR}/librewolf/librewolf.css" browser/themes/shared/preferences/librewolf.css || die
		cp -v "${FILESDIR}/librewolf/category-librewolf.svg" browser/themes/shared/preferences/category-librewolf.svg || die
	fi
	if use extension-firewall; then
		eapply "${FILESDIR}/librewolf/rs-blocker.patch"
	fi
	if use remove-pingsender; then
		eapply "${FILESDIR}/librewolf/remove-pingsender.patch"
	fi
	if use remove-openai; then
		eapply "${FILESDIR}/librewolf/remove-openai.patch"
	fi
	if use webgl-permission; then
		eapply "${FILESDIR}/librewolf/webgl-permission.patch"
	fi
	if use fingerprint-fixes; then
		eapply "${FILESDIR}/librewolf/fpp-canvas-fix.patch"
		if [[ ${_lw_patch_ver} == legacy ]]; then
			eapply "${FILESDIR}/librewolf/fix-canvas-extraction-permission.patch"
		else
			einfo "  Skipping fix-canvas-extraction-permission.patch (upstreamed in 154)"
		fi
	fi
	if use autoconfig-enhanced; then
		eapply "${FILESDIR}/librewolf/autoconfig-setEnv.patch"
		eapply "${FILESDIR}/librewolf/profile-directory.patch"
	fi
	if use remove-ads; then
		eapply "${FILESDIR}/librewolf/ui-patches/remove-cfrprefs.patch"
		eapply "${FILESDIR}/librewolf/urlbarprovider-interventions.patch"
	fi
	if use privacy-ui; then
		eapply "${FILESDIR}/librewolf/ui-patches/privacy-preferences.patch"
		eapply "${FILESDIR}/librewolf/ui-patches/hide-default-browser.patch"
		lw_apply_if_absent "${FILESDIR}/librewolf/ui-patches/hide-default-browser-alwayscheck.patch"
		if [[ ${_lw_patch_ver} == legacy ]]; then
			eapply "${FILESDIR}/librewolf/ui-patches/hide-finish-setup-bookmark.patch"
		else
			eapply "${FILESDIR}/librewolf/ui-patches/hide-finish-setup-bookmark-154.patch"
		fi
		eapply "${FILESDIR}/librewolf/ui-patches/remove-organization-policy-banner.patch"
	fi
	if use translation-fullpage; then
		eapply "${FILESDIR}/librewolf/fullpage-translations.patch"
		if [[ ${_lw_patch_ver} == legacy ]]; then
			eapply "${FILESDIR}/librewolf/fullpage-translations-utils-153.patch"
		else
			eapply "${FILESDIR}/librewolf/fullpage-translations-utils-154.patch"
		fi
		eapply "${FILESDIR}/librewolf/fullpage-translations-customization.patch"
	fi
	if use extension-uninstall-url; then
		eapply "${FILESDIR}/librewolf/extensions-setUninstallURL.patch"
	fi
	if use permission-tweaks; then
		eapply "${FILESDIR}/librewolf/eme-permission.patch"
		eapply "${FILESDIR}/librewolf/lw-permissions.patch"
		eapply "${FILESDIR}/librewolf/ui-patches/allow_cookies_for_site.patch"
		if [[ ${_lw_patch_ver} == legacy ]]; then
			eapply "${FILESDIR}/librewolf/ui-patches/allow_cookies_for_site-trustpanel-153.patch"
		else
			eapply "${FILESDIR}/librewolf/ui-patches/allow_cookies_for_site-trustpanel-154.patch"
		fi
		eapply "${FILESDIR}/librewolf/limit-access.patch"
	fi
	if use ui-tweaks; then
		if [[ ${_lw_patch_ver} == legacy ]]; then
			eapply "${FILESDIR}/librewolf/ui-patches/firefox-view.patch"
		else
			einfo "  Skipping firefox-view.patch (upstreamed in 154)"
		fi
		eapply "${FILESDIR}/librewolf/ui-patches/handlers.patch"
		eapply "${FILESDIR}/librewolf/ui-patches/neterror.patch"
		eapply "${FILESDIR}/librewolf/ui-patches/pref-naming.patch"
		eapply "${FILESDIR}/librewolf/ui-patches/home-preferences.patch"
		eapply "${FILESDIR}/librewolf/ui-patches/trustpanel.patch"
		eapply "${FILESDIR}/librewolf/ui-patches/website-appearance-ui-rfp.patch"
	fi
	if use link-preview; then
		eapply "${FILESDIR}/librewolf/link-preview.patch"
	fi
	if use language-packs; then
		eapply "${FILESDIR}/librewolf/languages.patch"
		eapply "${FILESDIR}/librewolf/remove-language-packs.patch"
	fi
	if use xdg-profile; then
		eapply "${FILESDIR}/librewolf/xdg-dir.patch"
		if [[ ${_lw_patch_ver} == legacy ]]; then
			eapply "${FILESDIR}/librewolf/xdg-dir-153.patch"
		else
			eapply "${FILESDIR}/librewolf/xdg-dir-154.patch"
		fi
	fi
	if use newtab-fixes; then
		eapply "${FILESDIR}/librewolf/newtab-fix.patch"
	fi

	export CARGO_BUILD_JOBS="$(makeopts_jobs)"
	if ! use elibc_glibc ; then
		if use amd64 ; then export RUST_TARGET="x86_64-unknown-linux-musl"
		elif use x86 ; then export RUST_TARGET="i686-unknown-linux-musl"
		elif use arm64 ; then export RUST_TARGET="aarch64-unknown-linux-musl"
		elif use loong; then export RUST_TARGET="loongarch64-unknown-linux-musl"
		elif use ppc64 ; then export RUST_TARGET="powerpc64le-unknown-linux-musl"
		elif use riscv ; then export RUST_TARGET="riscv64gc-unknown-linux-musl"
		else die "Unknown musl chost"
		fi
	fi
	if use wasm-sandbox ; then
		if use amd64 ; then export wasi_arch="x86_64"
		elif use arm64 ; then export wasi_arch="arm64"
		else die "wasm-sandbox enabled on unknown/unsupported arch!"
		fi
		sed -i -e "s:%%PORTAGE_WORKDIR%%:${WORKDIR}:" -e "s:%%WASI_ARCH%%:${wasi_arch}:" -e "s:%%WASI_SDK_VER%%:${WASI_SDK_VER}:" -e "s:%%WASI_SDK_LLVM_VER%%:${WASI_SDK_LLVM_VER}:" toolkit/moz.configure || die
	fi
	sed -i -e "s/multiprocessing.cpu_count()/$(makeopts_jobs)/" "${S}"/build/moz.configure/lto-pgo.configure || die
	sed -i -e "s/multiprocessing.cpu_count()/$(makeopts_jobs)/" "${S}"/third_party/chromium/build/toolchain/get_cpu_count.py || die
	sed -i -e "s/multiprocessing.cpu_count()/$(makeopts_jobs)/" "${S}"/third_party/python/gyp/pylib/gyp/input.py || die
	sed -i -e "s/objdump/${CHOST}-objdump/" "${S}"/python/mozbuild/mozbuild/configure/check_debug_ranges.py || die
	sed -i -e 's/ccache_stats = None/return None/' "${S}"/python/mozbuild/mozbuild/controller/building.py || die

	einfo "Removing pre-built binaries ..."
	find "${S}"/third_party -type f \( -name '*.so' -o -name '*.o' \) -print -delete || die
	moz_clear_vendor_checksums glslopt
	moz_clear_vendor_checksums encoding_rs
	moz_clear_vendor_checksums bindgen

	if [[ -n ${FILES_PER_UNIFIED_FILE} ]] && use jumbo-build; then
		local my_files_per_unified_file=${FILES_PER_UNIFIED_FILE:=16}
		sed -i -e "s/\"FILES_PER_UNIFIED_FILE\", 16/\"FILES_PER_UNIFIED_FILE\", "${my_files_per_unified_file}"/" python/mozbuild/mozbuild/frontend/data.py || die
		sed -i -e "s/FILES_PER_UNIFIED_FILE = 6/FILES_PER_UNIFIED_FILE = "${my_files_per_unified_file}"/" js/src/moz.build || die
	fi

	BUILD_DIR="${WORKDIR}/${PN}_build"
	mkdir -p "${BUILD_DIR}" || die
	echo -n "${MOZ_API_KEY_GOOGLE//gGaPi/}" > "${S}"/api-google.key || die
	echo -n "${MOZ_API_KEY_LOCATION//gGaPi/}" > "${S}"/api-location.key || die
	echo -n "${MOZ_API_KEY_MOZILLA//m0ap1/}" > "${S}"/api-mozilla.key || die
	xdg_environment_reset
}

src_configure() {
	einfo "Current BINDGEN_CFLAGS:\t${BINDGEN_CFLAGS:-no value set}"
	einfo "Current CFLAGS:\t\t${CFLAGS:-no value set}"
	einfo "Current CXXFLAGS:\t\t${CXXFLAGS:-no value set}"
	einfo "Current LDFLAGS:\t\t${LDFLAGS:-no value set}"
	einfo "Current RUSTFLAGS:\t\t${RUSTFLAGS:-no value set}"

	local have_switched_compiler=
	if use clang; then
		einfo "Enforcing the use of clang due to USE=clang ..."
		local version_clang=$(clang --version 2>/dev/null | grep -F -- 'clang version' | awk '{ print $3 }')
		[[ -n ${version_clang} ]] && version_clang=$(ver_cut 1 "${version_clang}")
		[[ -z ${version_clang} ]] && die "Failed to read clang version!"
		if tc-is-gcc; then have_switched_compiler=yes; fi
		AR=llvm-ar; CC=${CHOST}-clang-${version_clang}; CXX=${CHOST}-clang++-${version_clang}; NM=llvm-nm; RANLIB=llvm-ranlib
	elif ! use clang && ! tc-is-gcc ; then
		have_switched_compiler=yes
		einfo "Enforcing the use of gcc due to USE=-clang ..."
		AR=gcc-ar; CC=${CHOST}-gcc; CXX=${CHOST}-g++; NM=gcc-nm; RANLIB=gcc-ranlib
	fi
	if [[ -n "${have_switched_compiler}" ]] ; then strip-unsupported-flags; fi

	export HOST_CC="$(tc-getBUILD_CC)"; export HOST_CXX="$(tc-getBUILD_CXX)"; export AS="$(tc-getCC) -c"
	READELF="llvm-readelf"; tc-export CC CXX LD AR AS NM OBJDUMP RANLIB READELF PKG_CONFIG
	if tc-is-cross-compiler ; then export BINDGEN_CFLAGS="${SYSROOT:+--sysroot=${ESYSROOT}} --target=${CHOST} ${BINDGEN_CFLAGS-}"; fi

	if use rozelynx; then
		export MOZILLA_FIVE_HOME="/usr/$(get_libdir)/rozelynx"
	else
		export MOZILLA_FIVE_HOME="/usr/$(get_libdir)/${PN}"
	fi

	export SHELL="${EPREFIX}/bin/bash"; export MOZBUILD_STATE_PATH="${BUILD_DIR}"; export MOZCONFIG="${S}/.mozconfig"

	mozconfig_add_options_ac '' --enable-application=browser
	mozconfig_add_options_ac '' --enable-project=browser
	if use telemetry; then export MOZILLA_OFFICIAL=1; fi

	mozconfig_add_options_ac 'Gentoo default' \
		--allow-addon-sideload --disable-cargo-incremental --disable-crashreporter --disable-disk-remnant-avoidance \
		--disable-geckodriver --disable-install-strip --disable-legacy-profile-creation --disable-parental-controls \
		--disable-strip --disable-updater --enable-negotiateauth --enable-new-pass-manager \
		--enable-official-branding --enable-packed-relative-relocs --enable-release --enable-system-policies \
		--host="x86_64-unknown-linux-gnu" --libdir="${EPREFIX}/usr/$(get_libdir)" --prefix="${EPREFIX}/usr" \
		--target="x86_64-unknown-linux-gnu" --without-ccache --with-intl-api --with-libclang-path="$(llvm-config --libdir)" \
		--with-system-ffi --with-system-gbm --with-system-libdrm --with-system-nspr --with-system-nss \
		--with-system-pixman --with-system-zlib --with-toolchain-prefix="${CHOST}-" --with-unsigned-addon-scopes=app,system

	if use rozelynx; then
		mozconfig_add_options_ac 'rozelynx branding' --with-app-name=rozelynx --with-app-basename=rozelynx \
			--with-branding=browser/branding/rozelynx
		mozconfig_add_options_ac 'rozelynx allow unsigned' --disable-official-branding --disable-release
	fi

	local update_channel=release
	use rozelynx && update_channel=rozelynx
	[[ -n ${MOZ_ESR} ]] && update_channel=esr
	mozconfig_add_options_ac '' --enable-update-channel=${update_channel}

	if use amd64 || use arm64 || use ppc64 || use loong || use riscv ; then mozconfig_add_options_ac '' --enable-rust-simd; fi
	if use loong || use ppc64 || use riscv; then mozconfig_add_options_ac '' --disable-sandbox
	elif use valgrind; then mozconfig_add_options_ac 'valgrind requirement' --disable-sandbox
	else mozconfig_add_options_ac '' --enable-sandbox; fi
	if use riscv ; then
		mozconfig_add_options_ac 'Disable webrtc for RISC-V' --disable-webrtc
		mozconfig_add_options_ac 'Disable JIT for RISC-V' --disable-jit
	fi

	if [[ -s "${S}/api-google.key" ]] ; then
		local key_origin="Gentoo default"
		if [[ $(cat "${S}/api-google.key" | md5sum | awk '{ print $1 }') != 709560c02f94b41f9ad2c49207be6c54 ]] ; then key_origin="User value"; fi
		mozconfig_add_options_ac "${key_origin}" --with-google-safebrowsing-api-keyfile="${S}/api-google.key"
	else einfo "Building without Google API key ..."; fi
	if [[ -s "${S}/api-location.key" ]] ; then
		local key_origin="Gentoo default"
		if [[ $(cat "${S}/api-location.key" | md5sum | awk '{ print $1 }') != ffb7895e35dedf832eb1c5d420ac7420 ]] ; then key_origin="User value"; fi
		mozconfig_add_options_ac "${key_origin}" --with-google-location-service-api-keyfile="${S}/api-location.key"
	else einfo "Building without Location API key ..."; fi
	if [[ -s "${S}/api-mozilla.key" ]] ; then
		local key_origin="Gentoo default"
		if [[ $(cat "${S}/api-mozilla.key" | md5sum | awk '{ print $1 }') != 3927726e9442a8e8fa0e46ccc39caa27 ]] ; then key_origin="User value"; fi
		mozconfig_add_options_ac "${key_origin}" --with-mozilla-api-keyfile="${S}/api-mozilla.key"
	else einfo "Building without Mozilla API key ..."; fi

	mozconfig_use_with system-av1; mozconfig_use_with system-harfbuzz; mozconfig_use_with system-icu
	mozconfig_use_with system-jpeg; mozconfig_use_with system-libevent; mozconfig_use_with system-libvpx
	mozconfig_use_with system-pipewire; mozconfig_use_with system-png; mozconfig_use_with system-webp
	mozconfig_use_enable dbus; mozconfig_use_enable libproxy; mozconfig_use_enable valgrind
	use eme-free && mozconfig_add_options_ac '+eme-free' --disable-eme

	if use hardened ; then
		mozconfig_add_options_ac "+hardened" --enable-hardening
		mozconfig_add_options_ac "+hardened stl" --enable-stl-hardening
		append-ldflags "-Wl,-z,relro -Wl,-z,now"
		sed -i -e '/-D_FORTIFY_SOURCE=/s:2:3:' "${S}"/build/moz.configure/toolchain.configure || die
	fi

	local myaudiobackends=""
	use jack && myaudiobackends+="jack,"
	use sndio && myaudiobackends+="sndio,"
	use pulseaudio && myaudiobackends+="pulseaudio,"
	! use pulseaudio && myaudiobackends+="alsa,"
	mozconfig_add_options_ac '--enable-audio-backends' --enable-audio-backends="${myaudiobackends::-1}"
	mozconfig_use_enable wifi necko-wifi
	! use jumbo-build && mozconfig_add_options_ac '--disable-unified-build' --disable-unified-build

	if use X && use wayland ; then mozconfig_add_options_ac '+x11+wayland' --enable-default-toolkit=cairo-gtk3-x11-wayland
	elif ! use X && use wayland ; then mozconfig_add_options_ac '+wayland' --enable-default-toolkit=cairo-gtk3-wayland-only
	else mozconfig_add_options_ac '+x11' --enable-default-toolkit=cairo-gtk3-x11-only; fi

	if use wasm-sandbox ; then
		mozconfig_add_options_ac '+wasm-sandbox' --with-wasi-sysroot="${WORKDIR}/wasi-sdk-${WASI_SDK_VER}-${wasi_arch}-linux/share/wasi-sysroot/"
	else
		mozconfig_add_options_ac 'no wasm-sandbox' --without-wasm-sandboxed-libraries
		mozconfig_use_with system-harfbuzz system-graphite2
	fi
	! use jpegxl && mozconfig_add_options_ac '-jpegxl' --disable-jxl

	if [[ ${use_lto} == "yes" ]] ; then
		if use clang ; then
			if tc-ld-is-mold ; then append-ldflags "-flto=thin"; mozconfig_add_options_ac "using ld=mold due to system selection" --enable-linker=mold
			else mozconfig_add_options_ac "forcing ld=lld due to USE=clang and USE=lto" --enable-linker=lld; fi
			mozconfig_add_options_ac '+lto' --enable-lto=cross
		else mozconfig_add_options_ac '+lto' --enable-lto=full; mozconfig_add_options_ac "linker is set to bfd" --enable-linker=bfd; fi
	else
		if use clang ; then
			if tc-ld-is-mold ; then mozconfig_add_options_ac "using ld=mold due to system selection" --enable-linker=mold
			else mozconfig_add_options_ac "forcing ld=lld due to USE=clang" --enable-linker=lld; fi
		else
			if tc-ld-is-mold ; then mozconfig_add_options_ac "using ld=mold due to system selection" --enable-linker=mold
			else mozconfig_add_options_ac "linker is set to bfd due to USE=-clang" --enable-linker=bfd; fi
		fi
	fi

	if use pgo ; then
		mozconfig_add_options_ac '+pgo' MOZ_PGO=1; export MOZ_PKG_FORMAT=TAR
		if use clang ; then export LLVM_PROFDATA="llvm-profdata"; else export MOZ_REMOTE_SETTINGS_DEVTOOLS=1; fi
	fi

	mozconfig_use_enable debug
	if use debug ; then
		mozconfig_add_options_ac '+debug' --disable-optimize; mozconfig_add_options_ac '+debug' --enable-jemalloc; mozconfig_add_options_ac '+debug' --enable-real-time-tracing
	else
		mozconfig_add_options_ac 'Gentoo defaults' --disable-real-time-tracing
		if is-flag '-g*' ; then
			if use clang ; then mozconfig_add_options_ac 'from CFLAGS' --enable-debug-symbols=$(get-flag '-g*')
			else mozconfig_add_options_ac 'from CFLAGS' --enable-debug-symbols; fi
		else mozconfig_add_options_ac 'Gentoo default' --disable-debug-symbols; fi
		if is-flag '-O0' ; then mozconfig_add_options_ac "from CFLAGS" --enable-optimize=-O0
		elif is-flag '-O4' ; then mozconfig_add_options_ac "from CFLAGS" --enable-optimize=-O4
		elif is-flag '-O3' ; then mozconfig_add_options_ac "from CFLAGS" --enable-optimize=-O3
		elif is-flag '-O1' ; then mozconfig_add_options_ac "from CFLAGS" --enable-optimize=-O1
		elif is-flag '-Os' ; then mozconfig_add_options_ac "from CFLAGS" --enable-optimize=-Os
		else mozconfig_add_options_ac "Gentoo default" --enable-optimize=-O2; fi
	fi
	filter-flags '-g*'; filter-flags '-O*'

	if use amd64 || use x86 ; then
		filter-flags "-z,pack-relative-relocs"
		if tc-ld-is-mold ; then mozconfig_add_options_ac 'disable elf-hack with mold linker' --disable-elf-hack
		else mozconfig_add_options_ac 'relr elf-hack' --enable-elf-hack=relr; fi
	elif use loong || use ppc64 || use riscv ; then :;
	else mozconfig_add_options_ac 'disable elf-hack on non-supported arches' --disable-elf-hack; fi

	if ! use elibc_glibc; then mozconfig_add_options_ac '!elibc_glibc' --disable-jemalloc; fi
	if use valgrind; then mozconfig_add_options_ac 'valgrind requirement' --disable-jemalloc; fi
	use system-av1 && append-ldflags "-Wl,--undefined-version"
	append-ldflags -Wl,-rpath="${MOZILLA_FIVE_HOME}",--enable-new-dtags
	export MOZ_MAKE_FLAGS="${MAKEOPTS}"; export PIP_NETWORK_INSTALL_RESTRICTED_VIRTUALENVS=mach; export MACH_BUILD_PYTHON_NATIVE_PACKAGE_SOURCE="none"

	if ! use telemetry; then
		mozconfig_add_options_mk '-telemetry setting' "MOZ_CRASHREPORTER=0"
		mozconfig_add_options_mk '-telemetry setting' "MOZ_DATA_REPORTING=0"
		mozconfig_add_options_mk '-telemetry setting' "MOZ_SERVICES_HEALTHREPORT=0"
		mozconfig_add_options_mk '-telemetry setting' "MOZ_TELEMETRY_REPORTING=0"
	fi

	mozconfig_use_enable test tests; export MOZ_NOSPAM=1
	mozconfig_add_options_ac 'Gentoo default' "XARGS=${EPREFIX}/usr/bin/xargs"
	mozconfig_add_options_mk 'Gentoo default' "MOZ_OBJDIR=${BUILD_DIR}"

	if [[ -n ${EXTRA_ECONF} ]] ; then
		IFS=\! read -a ac <<<${EXTRA_ECONF// --/\!}
		for opt in "${ac[@]}"; do mozconfig_add_options_ac "EXTRA_ECONF" --${opt#--}; done
	fi

	echo; echo "=========================================================="
	echo "Building ${PF} with the following configuration"
	grep ^ac_add_options "${MOZCONFIG}" | while read ac opt hash reason; do
		[[ -z ${hash} || ${hash} == \# ]] || die "error reading mozconfig: ${ac} ${opt} ${hash} ${reason}"
		printf "    %-30s  %s\n" "${opt}" "${reason:-mozilla.org default}"
	done
	echo "=========================================================="; echo

	if use valgrind; then sed -i -e 's/--enable-optimize=-O[0-9s]/--enable-optimize="-g -O2"/' .mozconfig || die; fi
	./mach configure || die
}

src_compile() {
	local virtx_cmd=
	if [[ ${use_lto} == "yes" ]] && tc-ld-is-mold ; then
		if ! ulimit -n 16384 1>/dev/null 2>&1 ; then ewarn "Unable to modify ulimits - building with mold+lto might fail."
		else ulimit -n 16384; fi
	fi
	if use pgo; then gnome2_environment_reset; addpredict /root
		if ! use X; then virtx_cmd=virtwl; else virtx_cmd=virtx; fi; fi
	if ! use X; then local -x GDK_BACKEND=wayland; else local -x GDK_BACKEND=x11; fi
	${virtx_cmd} ./mach build --verbose || die
}

src_test() {
	local -x MOZ_HEADLESS=1; local -a failures=()
	einfo "Testing with cppunittest ..."; ./mach cppunittest; local ret=$?
	if [[ ${ret} -ne 0 ]]; then eerror "Test suite cppunittest failed with error code ${ret}"; failures+=( cppunittest ); fi
	if [[ ${#failures} -eq 0 ]]; then einfo "Test suites succeeded"; else die "Test suites failed: ${failures[@]}"; fi
}

src_install() {
	# Binary name differs when rozelynx branding is active
	local bin_name=${PN}
	use rozelynx && bin_name=rozelynx

	pax-mark m "${BUILD_DIR}"/dist/bin/xpcshell "${BUILD_DIR}"/dist/bin/${bin_name} "${BUILD_DIR}"/dist/bin/plugin-container
	DESTDIR="${D}" ./mach install || die
	rm "${ED}${MOZILLA_FIVE_HOME}/${bin_name}-bin" || die
	dosym ${bin_name} ${MOZILLA_FIVE_HOME}/${bin_name}-bin
	if [[ -f "${ED}${MOZILLA_FIVE_HOME}/llvm-symbolizer" ]] ; then rm -v "${ED}${MOZILLA_FIVE_HOME}/llvm-symbolizer" || die; fi

	insinto "${MOZILLA_FIVE_HOME}/distribution"
	newins "${FILESDIR}"/distribution.ini distribution.ini

	local PREFS_DIR="${MOZILLA_FIVE_HOME}/browser/defaults/preferences"
	insinto "${PREFS_DIR}"
	newins "${FILESDIR}"/gentoo-default-prefs.js gentoo-prefs.js
	local GENTOO_PREFS="${ED}${PREFS_DIR}/gentoo-prefs.js"

	cat >>"${GENTOO_PREFS}" <<-EOF || die
	pref("spellchecker.dictionary_path", "${EPREFIX}/usr/share/myspell");
	EOF

	# RozeLynx prefs
	if use rozelynx; then
		einfo "Installing RozeLynx system preferences..."
		insinto "${PREFS_DIR}"
		newins "${FILESDIR}/rozelynx/prefs/rozelynx-prefs.js" rozelynx-prefs.js
	fi

	if use hwaccel ; then
		cat "${FILESDIR}"/gentoo-hwaccel-prefs.js-r2 >>"${GENTOO_PREFS}" || die
		if use wayland; then
			cat >>"${GENTOO_PREFS}" <<-EOF || die
			pref("gfx.x11-egl.force-enabled", false);
			EOF
		else
			cat >>"${GENTOO_PREFS}" <<-EOF || die
			pref("gfx.x11-egl.force-enabled", true);
			EOF
		fi
		exeinto "${MOZILLA_FIVE_HOME}"; doexe "${BUILD_DIR}"/dist/bin/vaapitest; doexe "${BUILD_DIR}"/dist/bin/vulkantest
		if use arm64 ; then exeinto "${MOZILLA_FIVE_HOME}"; doexe "${BUILD_DIR}"/dist/bin/v4l2test; fi
	fi

	if ! use gmp-autoupdate ; then
		local plugin
		for plugin in "${MOZ_GMP_PLUGIN_LIST[@]}" ; do
			einfo "Disabling auto-update for ${plugin} plugin ..."
			cat >>"${GENTOO_PREFS}" <<-EOF || die
			pref("media.${plugin}.autoupdate", false);
			EOF
		done
	fi

	if use system-harfbuzz ; then
		cat >>"${GENTOO_PREFS}" <<-EOF || die
		sticky_pref("gfx.font_rendering.graphite.enabled", true);
		EOF
	fi

	# Standard telemetry prefs and LibreWolf prefs (abbreviated but functional)
	if ! use telemetry ; then
		cat "${FILESDIR}"/gentoo-telemetry-prefs.js >>"${GENTOO_PREFS}" || die
		cat >>"${GENTOO_PREFS}" <<-'ANALYTICS_EOF' || die
		pref("toolkit.telemetry.unified", false);
		pref("toolkit.telemetry.enabled", false);
		pref("datareporting.policy.dataSubmissionEnabled", false);
		pref("app.shield.optoutstudies.enabled", false);
		pref("app.normandy.enabled", false);
		pref("app.normandy.api_url", "");
		ANALYTICS_EOF
	fi

	# LibreWolf privacy hardening prefs (essential ones)
	local any_librewolf_flag=
	if use remove-safebrowsing || use remove-pocket || use remove-password-manager \
		|| use remove-sponsored || use librewolf-ui || use extension-firewall \
		|| use remove-pingsender || use remove-openai || use webgl-permission \
		|| use fingerprint-fixes || use autoconfig-enhanced || use remove-ads \
		|| use privacy-ui || use translation-fullpage || use extension-uninstall-url \
		|| use permission-tweaks || use ui-tweaks || use link-preview \
		|| use language-packs || use xdg-profile || use newtab-fixes; then
		any_librewolf_flag=1
	fi

	if [[ -n ${any_librewolf_flag} ]]; then
		einfo "Installing LibreWolf-style privacy configuration..."
		insinto "${MOZILLA_FIVE_HOME}/defaults/pref"
		doins "${FILESDIR}/librewolf/local-settings.js"
		insinto "${MOZILLA_FIVE_HOME}"
		doins "${FILESDIR}/librewolf/librewolf.cfg"
		if use remove-pocket; then
			insinto "${MOZILLA_FIVE_HOME}/distribution"
			newins "${FILESDIR}/librewolf/policies.json" policies.json
		fi
	fi

	if use remove-safebrowsing; then
		cat >>"${GENTOO_PREFS}" <<-'SAFEBROWSING_EOF' || die
		pref("browser.safebrowsing.malware.enabled", false);
		pref("browser.safebrowsing.phishing.enabled", false);
		pref("browser.safebrowsing.downloads.enabled", false);
		SAFEBROWSING_EOF
	fi
	if use remove-pocket; then
		cat >>"${GENTOO_PREFS}" <<-'POCKET_EOF' || die
		pref("extensions.pocket.enabled", false);
		pref("extensions.pocket.api", "");
		pref("extensions.pocket.site", "");
		POCKET_EOF
	fi
	if use remove-password-manager; then
		cat >>"${GENTOO_PREFS}" <<-'PWMGR_EOF' || die
		pref("librewolf.hidePasswdmgr", true);
		pref("signon.rememberSignons", false);
		pref("signon.autofillForms", false);
		pref("signon.generation.enabled", false);
		PWMGR_EOF
	fi

	# --- Install RozeLynx extension ---
	if use rozelynx; then
		rozelynx_assemble_extension

		if [[ -n "${ROZELYNX_EXT_DEST}" && -d "${ROZELYNX_EXT_DEST}" ]]; then
			# Create XPI from the assembled extension directory
			local ext_xpi="${T}/rozelynx-features@bytewheel.org.xpi"
			einfo "Packaging RozeLynx Features extension as XPI..."
			(
				cd "${ROZELYNX_EXT_DEST}" || die
				zip -qr "${ext_xpi}" . || die "Failed to create XPI"
			)

			# Install XPI to distribution/extensions
			local ext_install_dir="${MOZILLA_FIVE_HOME}/distribution/extensions"
			# Remove old directory-format extension from previous installs
			rm -rf "${ED}${ext_install_dir}/rozelynx-features@bytewheel.org" 2>/dev/null || true
			insinto "${ext_install_dir}"
			newins "${ext_xpi}" "rozelynx-features@bytewheel.org.xpi"
			einfo "Installed RozeLynx Features XPI to ${ext_install_dir}/"

			# Also register in policies.json to force-install (force_installed bypasses signing)
			local policies_json="${ED}${MOZILLA_FIVE_HOME}/distribution/policies.json"
			if [[ -f "${policies_json}" ]]; then
				einfo "Registering RozeLynx Features in policies.json..."
				python3 -c "
import json
with open('${policies_json}') as f:
    p = json.load(f)
es = p['policies'].setdefault('ExtensionSettings', {})
es['rozelynx-features@bytewheel.org'] = {
    'installation_mode': 'force_installed',
    'install_url': 'file://${MOZILLA_FIVE_HOME}/distribution/extensions/rozelynx-features@bytewheel.org.xpi'
}
with open('${policies_json}', 'w') as f:
    json.dump(p, f, indent=4)
" || ewarn "Failed to update policies.json for extension registration"
			fi

			# RX Background Probe was a session-8 diagnostic (2-file aliveness
			# probe opening example.org/?rxbgtest=1 on every launch). It was
			# retired: users found the probe tab annoying, and PART A
			# verification (signedState NOT_REQUIRED, no banners) is complete.
		fi

		# Install Lepton skin browser chrome CSS (reference file for userChrome.css)
		if use lepton-skin; then
			einfo "Installing Lepton skin CSS files..."
			local chrome_css_dir="${MOZILLA_FIVE_HOME}/browser/defaults/rozelynx"
			insinto "${chrome_css_dir}"
			doins "${FILESDIR}/rozelynx/skins/lepton/css/leptonChrome.css"
			doins "${FILESDIR}/rozelynx/skins/lepton/css/leptonContent.css"
			# FF153-targeted adaptation layer (the upstream Lepton sheet
			# targets pre-128 UI); imported LAST so it wins the cascade.
			doins "${FILESDIR}/rozelynx/skins/lepton/css/rozelynxLepton.css"

			# Default userChrome.css that imports the Lepton skin.
			# Installed under both names:
			#  - userChrome.css: seeded into NEW profiles automatically
			#  - userChrome-lepton.css: reference copy for existing profiles
			# Firefox only resolves RELATIVE @imports (or chrome:// URLs)
			# from userChrome.css - absolute file:// imports are silently
			# dropped - so the skin sheets are also installed into
			# defaults/profile/chrome/ where profile seeding copies them
			# right next to userChrome.css.
			insinto "${MOZILLA_FIVE_HOME}/browser/defaults/profile/chrome"
			doins "${FILESDIR}/rozelynx/skins/lepton/css/leptonChrome.css"
			doins "${FILESDIR}/rozelynx/skins/lepton/css/rozelynxLepton.css"
			cat > "${T}/userChrome-lepton.css" <<-'CHROMEEOF' || die
/* RozeLynx Lepton Skin - Browser Chrome Theme
 * To enable on an existing profile:
 *   1. In about:config set toolkit.legacyUserProfileCustomizations.stylesheets = true
 *   2. Copy this file to your profile's chrome/ directory as userChrome.css
 *      (e.g. ~/.rozelynx/chrome/userChrome.css)
 * New profiles get userChrome.css automatically (defaults/profile seeding).
 * The RozeLynx Features options page can also toggle this (restart to apply).
 * The CSS files must sit next to userChrome.css in the profile chrome dir;
 * the options page links them there automatically.
 */
@import url("leptonChrome.css");
@import url("rozelynxLepton.css");
CHROMEEOF
		doins "${T}/userChrome-lepton.css"
		cp "${T}/userChrome-lepton.css" "${T}/userChrome.css" || die
		doins "${T}/userChrome.css"
		fi

		# SSB (PWA) window chrome: shipped CSS + userChrome import so
		# `rozelynx --ssb <url>` windows hide the tab strip / nav bar.
		if use pwa; then
			insinto "${MOZILLA_FIVE_HOME}/browser/defaults/rozelynx"
			doins "${FILESDIR}/rozelynx/skins/ssb/ssbChrome.css"

			# SSB sheet must also land in the seeded profile chrome dir so
			# the relative @import below resolves for new profiles.
			insinto "${MOZILLA_FIVE_HOME}/browser/defaults/profile/chrome"
			doins "${FILESDIR}/rozelynx/skins/ssb/ssbChrome.css"

			local ssb_import="@import url(\"ssbChrome.css\");"
			if [[ -f "${T}/userChrome.css" ]]; then
				echo "${ssb_import}" >> "${T}/userChrome.css"
				[[ -f "${T}/userChrome-lepton.css" ]] && \
					echo "${ssb_import}" >> "${T}/userChrome-lepton.css"
				# re-install the updated copies
				insinto "${MOZILLA_FIVE_HOME}/browser/defaults/profile/chrome"
				doins "${T}/userChrome.css"
				[[ -f "${T}/userChrome-lepton.css" ]] && \
					doins "${T}/userChrome-lepton.css"
			else
				# pwa without lepton-skin: create the userChrome files here
				insinto "${MOZILLA_FIVE_HOME}/browser/defaults/profile/chrome"
				cat > "${T}/userChrome.css" <<-SSBEOF || die
/* RozeLynx SSB window chrome (PWA) */
${ssb_import}
SSBEOF
				doins "${T}/userChrome.css"
			fi
		fi

		# Private-TAB favicon rule (claw mark). Installed unconditionally and
		# imported from every seeded userChrome.css, alongside the SSB import.
		#
		# It cannot be shipped inside omni.ja: browser chrome CSS is only read
		# from the profile, and it is not gated on lepton-skin or pwa because a
		# private tab should read as private whether or not the skin is on. It is
		# installed into browser/defaults/rozelynx, which the host lists in
		# SKIN_FILES so it is symlinked into each profile's chrome dir and
		# imported by bare filename (see CHROME_ALWAYS_IMPORTS). Only the claw
		# artwork it references is a packaged skin file hit by chrome:// URL.
		if [[ -f "${FILESDIR}/rozelynx/branding/privateNewtabChrome.css" ]]; then
			insinto "${MOZILLA_FIVE_HOME}/browser/defaults/rozelynx"
			doins "${FILESDIR}/rozelynx/branding/privateNewtabChrome.css"
			einfo "  Private-NEWTAB favicon rule installed"
		else
			ewarn "branding/privateNewtabChrome.css absent; private newtab keeps the paw mark"
		fi


		# External browser support: native messaging host (browser detection
		# for the context-menu submenu) + rozelynx-ext: scheme handler
		if use external-browser || use mouse-gestures; then
			einfo "Installing RozeLynx external browser launcher..."
			exeinto "${MOZILLA_FIVE_HOME}"
			doexe "${FILESDIR}/rozelynx/host/rozelynx-host"
			doexe "${FILESDIR}/rozelynx/host/open-external"
			insinto "${MOZILLA_FIVE_HOME}"
			doins "${FILESDIR}/rozelynx/host/browsers.sh"

			# Native messaging manifest. Firefox looks up <name>.json, so
			# the file must be rozelynx_host.json. Locations: the user's
			# ~/.mozilla dir plus XRESysNativeManifests =
			# /usr/$(get_libdir)/mozilla/native-messaging-hosts (lib64-
			# aware since this build has HAVE_USR_LIB64_DIR).
			sed -e "s:@PATH@:${MOZILLA_FIVE_HOME}/rozelynx-host:" \
				"${FILESDIR}/rozelynx/host/rozelynx.json" \
				> "${T}/rozelynx-host-manifest.json" || die
			insinto "${EPREFIX}/usr/$(get_libdir)/mozilla/native-messaging-hosts"
			newins "${T}/rozelynx-host-manifest.json" rozelynx_host.json
			# Compatibility copy for builds without HAVE_USR_LIB64_DIR
			# (and other Firefox-based browsers reading /usr/lib/mozilla).
			insinto /usr/lib/mozilla/native-messaging-hosts
			newins "${T}/rozelynx-host-manifest.json" rozelynx_host.json

			# x-scheme-handler/rozelynx-ext desktop entry. Installed as
			# rozelynx-default.desktop so it sorts first in the
			# mimeinfo.cache (GIO's fallback "default" = first entry;
			# the handler shows a native browser-choice dialog).
			sed -e "s:@EXEC@:${MOZILLA_FIVE_HOME}/open-external:" \
				"${FILESDIR}/rozelynx/host/rozelynx-open-external.desktop" \
				> "${T}/rozelynx-default.desktop" || die
			insinto /usr/share/applications
			doins "${T}/rozelynx-default.desktop"
		fi
	fi

	# --- Install icons and desktop ---
	if use rozelynx; then
		insinto /usr/share/icons/hicolor/symbolic/apps
		newins "${FILESDIR}/rozelynx/icon/rozelynx-symbolic.svg" rozelynx-symbolic.svg

		insinto /usr/share/icons/hicolor/scalable/apps
		newins "${FILESDIR}/rozelynx/icon/rozelynx.svg" rozelynx.svg

		dosym /usr/share/icons/hicolor/scalable/apps/rozelynx.svg \
			/usr/share/icons/hicolor/symbolic/apps/org.bytewheel.rozelynx-symbolic.svg

		# The installed "rozelynx" theme icon must be the actual RozeLynx
		# logo (notification daemons badge notifications with it; shipping
		# the official Firefox branding there shows a Firefox logo badge).
		# Prefer the RozeLynx-branded renders generated in src_prepare;
		# fall back to the official branding if rendering failed.
		local icon_srcdir="${S}/browser/branding/rozelynx"
		if [[ ! -d "${icon_srcdir}" ]] || [[ -z $(find "${icon_srcdir}" -maxdepth 1 -name "default*.png" 2>/dev/null) ]]; then
			ewarn "RozeLynx branding icons missing; falling back to official Firefox branding"
			icon_srcdir="${S}/browser/branding/official"
		fi
		local icon size
		for icon in "${icon_srcdir}"/default*.png ; do
			size=${icon%.png}; size=${size##*/default}
			if [[ ${size} -eq 48 ]] ; then newicon "${icon}" rozelynx.png; fi
			newicon -s ${size} "${icon}" rozelynx.png
		done

		# The launcher ladder, under its own name so the notification badge
		# above keeps the logo. Any size src_prepare did not render is skipped
		# rather than fatal, and the .desktop falls back per icon-theme rules.
		local launcher_icon
		for launcher_icon in "${icon_srcdir}"/launcher*.png ; do
			[[ -f "${launcher_icon}" ]] || continue
			local lsize=${launcher_icon%.png}; lsize=${lsize##*/launcher}
			newicon -s ${lsize} "${launcher_icon}" rozelynx-launcher.png
		done

		local app_name="RozeLynx"; local desktop_file="${FILESDIR}/rozelynx/icon/rozelynx.desktop"
		local exec_command="rozelynx"; local icon_name="rozelynx"; local use_wayland="false"

		if [[ -n ${MOZ_ESR} ]] ; then local desktop_filename="rozelynx-esr.desktop"
		else local desktop_filename="rozelynx.desktop"; fi

		if use wayland ; then use_wayland="true"; fi

		cp "${desktop_file}" "${WORKDIR}/rozelynx.desktop-template" || die
		sed -i \
			-e "s:@NAME@:${app_name}:" \
			-e "s:@EXEC@:${exec_command}:" \
			-e "s:@ICON@:${icon_name}:" \
			"${WORKDIR}/rozelynx.desktop-template" || die
		newmenu "${WORKDIR}/rozelynx.desktop-template" "${desktop_filename}"
		rm "${WORKDIR}/rozelynx.desktop-template" || die

		[[ -f "${ED}/usr/bin/${PN}" ]] && rm "${ED}/usr/bin/${PN}"
		newbin "${FILESDIR}/rozelynx/icon/rozelynx-r1.sh" rozelynx

		sed -i \
			-e "s:@PREFIX@:${EPREFIX}/usr:" \
			-e "s:@LIBDIR@:$(get_libdir):" \
			-e "s:@DEFAULT_WAYLAND@:${use_wayland}:" \
			-e "s:@VERSION@:${PV}:" \
			-e "s:@BUILD_DATE@:$(date -u +%Y-%m-%d):" \
			"${ED}/usr/bin/rozelynx" || die

		dosym rozelynx /usr/bin/firefox
	else
		# Standard Firefox icons
		local icon_srcdir="${S}/browser/branding/official"
		insinto /usr/share/icons/hicolor/symbolic/apps
		newins "${S}"/browser/installer/linux/app/flatpak/files/share/icons/hicolor/symbolic/apps/org.mozilla.firefox-symbolic.svg firefox-symbolic.svg
		dosym -r /usr/share/icons/hicolor/symbolic/apps/firefox-symbolic.svg /usr/share/icons/hicolor/symbolic/apps/org.mozilla.firefox-symbolic.svg

		local icon size
		for icon in "${icon_srcdir}"/default*.png ; do
			size=${icon%.png}; size=${size##*/default}
			if [[ ${size} -eq 48 ]] ; then newicon "${icon}" ${PN}.png; fi
			newicon -s ${size} "${icon}" ${PN}.png
		done

		local app_name="Mozilla ${MOZ_PN^}"; local desktop_file="${FILESDIR}/icon/${PN}-r3.desktop"
		local exec_command="${PN}"; local icon_name="${PN}"; local use_wayland="false"

		if [[ -n ${MOZ_ESR} ]] ; then local desktop_filename="${PN}-esr.desktop"
		else local desktop_filename="${PN}.desktop"; fi
		if use wayland ; then use_wayland="true"; fi

		cp "${desktop_file}" "${WORKDIR}/${PN}.desktop-template" || die
		sed -i \
			-e "s:@NAME@:${app_name}:" \
			-e "s:@EXEC@:${exec_command}:" \
			-e "s:@ICON@:${icon_name}:" \
			"${WORKDIR}/${PN}.desktop-template" || die
		newmenu "${WORKDIR}/${PN}.desktop-template" "${desktop_filename}"
		rm "${WORKDIR}/${PN}.desktop-template" || die

		[[ -f "${ED}/usr/bin/${PN}" ]] && rm "${ED}/usr/bin/${PN}"
		newbin "${FILESDIR}/${PN}-r1.sh" ${PN}
		sed -i -e "s:@PREFIX@:${EPREFIX}/usr:" -e "s:@DEFAULT_WAYLAND@:${use_wayland}:" "${ED}/usr/bin/${PN}" || die
	fi

	if use gnome-shell ; then
		insinto /usr/share/gnome-shell/search-providers/
		doins browser/components/shell/search-provider-files/org.mozilla.firefox.search-provider.ini
		insinto /usr/share/dbus-1/services/
		doins browser/components/shell/search-provider-files/org.mozilla.firefox.SearchProvider.service
		if [[ -n ${MOZ_ESR} ]] ; then
			sed -e "s/firefox.desktop/${desktop_filename}/g" \
				-i "${ED}/usr/share/gnome-shell/search-providers/org.mozilla.firefox.search-provider.ini" || die
		fi
		sed -e "s/Exec=\/usr\/bin\/firefox/Exec=\/usr\/$(get_libdir)\/firefox\/firefox --dbus-service \/usr\/bin\/firefox/g" \
			-i "${ED}/usr/share/dbus-1/services/org.mozilla.firefox.SearchProvider.service" || die
		cat >>"${GENTOO_PREFS}" <<-EOF || die
		pref("browser.gnome-search-provider.enabled", true);
		EOF
	fi

	if use jpegxl ; then
		cat >>"${GENTOO_PREFS}" <<-EOF || die
		pref("image.jxl.enabled", true);
		EOF
	fi

	readme.gentoo_create_doc
}

pkg_postinst() {
	xdg_pkg_postinst

	# Profile directory migration: Name=rozelynx + xdg-profile means
	# Firefox looks in ~/.config/rozelynx/ but profiles may live in
	# ~/.config/roselynx/bytewheel/rozelynx/ (old nested layout).
	# Flatten the profile data to where Firefox expects it.
	local old_profile="${HOME}/.config/roselynx"
	local new_profile="${HOME}/.config/rozelynx"
	if [[ -d "${old_profile}" ]] && [[ ! -f "${new_profile}/profiles.ini" ]]; then
		local nested_dir="${old_profile}/bytewheel/rozelynx"
		local nested_legacy="${old_profile}/bytewheel/roselynx"
		local src_dir=""
		if [[ -f "${nested_dir}/profiles.ini" ]]; then
			src_dir="${nested_dir}"
		elif [[ -f "${nested_legacy}/profiles.ini" ]]; then
			src_dir="${nested_legacy}"
		fi
		if [[ -n "${src_dir}" ]]; then
			mkdir -p "${new_profile}"
			cp "${src_dir}/profiles.ini" "${new_profile}/"
			# Copy profile directories referenced in profiles.ini
			local prof_path
			while IFS='=' read -r _ prof_path; do
				prof_path="${prof_path%%$'\r'}"
				if [[ -d "${src_dir}/${prof_path}" ]]; then
					cp -a "${src_dir}/${prof_path}" "${new_profile}/"
				fi
			done < <(grep '^Path=' "${src_dir}/profiles.ini")
			elog "Migrated profile data from ${src_dir} to ${new_profile}"
		fi
	fi

	if ! use gmp-autoupdate ; then
		elog "USE='-gmp-autoupdate' has disabled the following plugins from updating or"
		elog "installing into new profiles:"
		local plugin
		for plugin in "${MOZ_GMP_PLUGIN_LIST[@]}" ; do elog "\t ${plugin}"; done
		elog
	fi

	if use hwaccel && has_version "x11-drivers/xf86-video-nouveau"; then
		ewarn "You have nouveau drivers installed in your system and 'hwaccel' "
		ewarn "enabled for Firefox. Nouveau / your GPU might not support the "
		ewarn "required EGL, so either disable 'hwaccel' or try the workaround "
		ewarn "explained in https://bugs.gentoo.org/835078#c5 if Firefox crashes."
	fi

	if use rozelynx; then
		elog ""
		elog "RozeLynx features enabled!"
		elog "==========================="
		local modules=($(rozelynx_enabled_modules))
		if [[ ${#modules[@]} -gt 0 ]]; then
			elog "Extension modules: ${modules[*]}"
		else
			elog "No RozeLynx extension modules enabled."
			elog "Enable individual feature USE flags to add modules."
		fi
		if use pwa; then
			elog "PWA support: C++ Linux taskbar integration + JS layer enabled"
		fi
		if use rozelynx-debug; then
			elog "Dev protocol debug patches applied (CDP, Marionette, RemoteAgent, WebDriverBiDi)"
		fi
		if use lepton-skin; then
			elog "Lepton browser-chrome skin: copy the reference stylesheet to your"
			elog "profile's chrome/ directory as userChrome.css to enable it, e.g.:"
			elog "  mkdir -p \"/path/to/profile/chrome\""
			elog "  cp \"${MOZILLA_FIVE_HOME}/browser/defaults/profile/chrome/userChrome-lepton.css\" \"/path/to/profile/chrome/userChrome.css\""
			elog "(toolkit.legacyUserProfileCustomizations.stylesheets is already enabled)"
		fi
		if use net-iface; then
			local bin="${EROOT%/}/usr/$(get_libdir)/rozelynx/rozelynx"
			if [[ ! -f "${bin}" ]]; then
				ewarn "net-iface: ${bin} not found — CAP_NET_RAW not granted"
			elif ! command -v setcap >/dev/null 2>&1; then
				ewarn "net-iface: setcap tool not available — CAP_NET_RAW not granted"
			elif setcap cap_net_raw+ep "${bin}"; then
				elog "net-iface: SO_BINDTODEVICE network-interface pinning enabled"
				elog "  CAP_NET_RAW granted to: ${bin}"
				elog "  Verify: getcap ${bin}"
				elog "  Broker roadmap: phase 3 drops process-wide CAP_NET_RAW"
			else
				die "net-iface: setcap cap_net_raw+ep failed on ${bin}"
			fi
		fi
		if use external-browser || use mouse-gestures; then
			elog "External browser launcher installed:"
			elog "  native messaging host: ${MOZILLA_FIVE_HOME}/rozelynx-host"
			elog "  scheme handler:        rozelynx-ext: (launcher: ${MOZILLA_FIVE_HOME}/open-external)"
			elog "  activity log:          /tmp/rozelynx-open-external.log"
		fi
		elog ""
		elog "Available USE flags for features:"
		elog "  chrome-web-store   - Install extensions from Chrome Web Store"
		elog "  experiments        - A/B testing and feature flags"
		elog "  external-browser   - Open links in other browsers"
		elog "  i18n               - Locale management utilities"
		elog "  mouse-gestures     - Mouse gesture navigation"
		elog "  qr-code            - QR code generator"
		elog "  pwa                - Progressive Web App support"
		elog "  lepton-skin        - Compact Lepton UI theme"
		elog "  ip-protection      - IP protection privacy overrides"
		elog ""
	fi

	readme.gentoo_print_elog

	optfeature_header "Optional programs for extra features:"
	optfeature "desktop notifications" x11-libs/libnotify
	optfeature "fallback mouse cursor theme e.g. on WMs" gnome-base/gsettings-desktop-schemas
	optfeature "screencasting with pipewire" sys-apps/xdg-desktop-portal
	if use external-browser || use mouse-gestures; then
		optfeature "native browser-choice dialog for external links" x11-misc/zenity x11-misc/yad x11-misc/qarma kde-apps/kdialog
	fi

	if ! has_version "sys-libs/glibc"; then
		elog; elog "glibc not found! You won't be able to play DRM content."; elog
	fi
}
