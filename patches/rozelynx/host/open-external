#!/bin/sh
# RozeLynx external URL dispatcher.
# Registered as the handler for x-scheme-handler/rozelynx-ext.
#
# Receives (via desktop Exec %u): rozelynx-ext:<percent-encoded payload>
#   payload = BROWSER_ID:URL   (id "default" = system default via xdg-open;
#            other ids match the tables in browsers.sh)
# Legacy payloads without a browser id (plain URL) fall back to "default".
#
# BROWSER_FAKE=1 disables real launches and only logs (testing).

. "$(dirname -- "$(readlink -f -- "$0" 2>/dev/null || echo "$0")")/browsers.sh"
export LD_LIBRARY_PATH="/usr/lib64/rozelynx:${LD_LIBRARY_PATH:-}"

payload="${1:-}"

# Two invocation forms:
#   open-external rozelynx-ext:<percent-encoded payload>   (legacy scheme form,
#            payload = [BROWSER_ID:]URL)
#   open-external <browserId> <url>                        (per-browser desktop
#            entries generated by rozelynx-host)
if [ "$payload" != "${payload#rozelynx-ext:}" ]; then
	payload="${payload#rozelynx-ext:}"

	# Percent-decode (python3 is a portage requirement, always present).
	payload=$(printf '%s\n' "$payload" | python3 -c \
		'import sys, urllib.parse; sys.stdout.write(urllib.parse.unquote(sys.stdin.readline().rstrip("\n")))' \
		2>/dev/null)

	if [ -z "$payload" ]; then
		rozelynx_log "empty payload: $1"
		exit 1
	fi

	id="default"
	url="$payload"
	case "$payload" in
		*:*)
			candidate="${payload%%:*}"
			if rozelynx_browser_entry "$candidate" >/dev/null 2>&1 || [ "$candidate" = "default" ]; then
				id="$candidate"
				url="${payload#*:}"
			fi
			# Legacy payload without a browser id (plain URL like https://...)
			if [ "$id" = "default" ] && printf '%s\n' "$payload" | grep -Eq '^[a-zA-Z][a-zA-Z0-9+.-]*://'; then
				id="default"
				url="$payload"
			fi
			;;
	esac
else
	id="${1:-default}"
	url="${2:-}"
	if [ -z "$url" ]; then
		rozelynx_log "missing url (argv form)"
		exit 1
	fi
	# Desktop %u passes the full URI; drop the scheme prefix
	url="${url#rozelynx-ext:}"
	# The URL arrives percent-encoded from the scheme dispatch
	url=$(printf '%s\n' "$url" | python3 -c \
		'import sys, urllib.parse; sys.stdout.write(urllib.parse.unquote(sys.stdin.readline().rstrip("\n")))' \
		2>/dev/null)
fi

rozelynx_log "open-external: id=$id url=$url"

# No specific browser requested (button click): let the user pick from a
# native list dialog (Default browser, detected GUI browsers, CLI browsers
# in their terminal). Falls back to the system default when no dialog tool
# is available or the user cancels.
if [ "$id" = "default" ]; then
	chosen=$(rozelynx_show_chooser "$url")
	if [ -z "$chosen" ]; then
		rozelynx_log "chooser cancelled"
		exit 0
	fi
	if [ -n "$chosen" ] && [ "$chosen" != "default" ]; then
		id="$chosen"
	else
		if [ "${BROWSER_FAKE:-0}" = "1" ]; then
			rozelynx_log "FAKE default: xdg-open $url"
			exit 0
		fi
		xdg_bin=$(rozelynx_first_found "xdg-open")
		if [ -z "$xdg_bin" ]; then
			rozelynx_log "default: xdg-open not found"
			exit 1
		fi
		rozelynx_log "default: $xdg_bin $url"
		_browser_path="$(command -v "$(rozelynx_first_found "firefox")" 2>/dev/null)"
		_browser_name="$(basename "$(readlink -f "$_browser_path")")"
		if pgrep -x "$_browser_name" >/dev/null 2>&1; then
			"$xdg_bin" --new-tab "$url" &
		else
			"$xdg_bin" "$url" &
		fi
		exit 0
	fi
fi

entry=$(rozelynx_browser_entry "$id")
if [ -z "$entry" ]; then
	rozelynx_log "unknown browser id: $id"
	exit 1
fi
name=${entry%%|*}; entry=${entry#*|}
kind=${entry%%|*}; commands=${entry#*|}

cmd=$(rozelynx_first_found "$commands")
if [ -z "$cmd" ]; then
	rozelynx_log "browser not installed: $id"
	exit 1
fi

if [ "$kind" = "gui" ]; then
	if [ "${BROWSER_FAKE:-0}" = "1" ]; then
		rozelynx_log "FAKE gui[$id]: $cmd $url"
		exit 0
	fi
	rozelynx_log "gui[$id]: $cmd $url"
	# Single-instance guard: if the browser is already running,
	# open the URL in a new tab of the existing window instead of spawning a new process.
	_browser_path="$(command -v "$cmd" 2>/dev/null)"
	_browser_name="$(basename "$(readlink -f "$_browser_path")")"
	if pgrep -x "$_browser_name" >/dev/null 2>&1; then
		"$cmd" --new-tab "$url" &
	else
		"$cmd" "$url" &
	fi
	exit 0
fi

tid=$(rozelynx_preferred_terminal)
if [ -z "$tid" ]; then
	rozelynx_log "cli[$id]: no terminal emulator found"
	exit 1
fi
rozelynx_terminal_launch "$tid" "$cmd" "$url" || {
	rozelynx_log "cli[$id]: terminal launch failed"
	exit 1
}
exit 0
