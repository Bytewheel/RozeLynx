EXPORTS.mozilla.net += [
    "RozeLynxNetIface.h",
]

UNIFIED_SOURCES += [
    "RozeLynxNetIface.cpp",
]

XPIDL_SOURCES += [
    "nsIRozeLynxNetIface.idl",
]

XPIDL_MODULE = "rozelynxNetIface"

XPCOM_MANIFESTS += [
    "components.conf",
]

LOCAL_INCLUDES += [
    "/dom/base",
    # RozeLynx v13: DNSAdditionalInfo (attributed extension DNS lookups) and
    # TRRService (global network.trr.uri fallback) live in netwerk/dns.
    "/netwerk/dns",
]

# RozeLynx v13: TRRService.h pulls TRR.h -> DNSPacket.h -> DNSByTypeRecord.h
# -> ipc/glue/IPCMessageUtils.h, which needs the vendored chromium IPC
# headers (chrome/common/ipc_message.h) and the IPDL-generated headers.
# Same include set netwerk/dns itself uses.
include("/ipc/chromium/chromium-config.mozbuild")

FINAL_LIBRARY = "xul"
