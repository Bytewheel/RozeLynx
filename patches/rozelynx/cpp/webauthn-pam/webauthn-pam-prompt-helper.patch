+  // RozeLynx PAM passkeys: pick between the local platform
+  // authenticator (howdy face authentication / password) and the USB
+  // security key bridge for a registration.
+  rozelynx_pam_select(browsingContext, { origin, tid }) {
+    let [deviceLabel, usbLabel] = this._l10n.formatValuesSync([
+      "webauthn-rozelynx-pam-select-device",
+      "webauthn-rozelynx-pam-select-usb",
+    ]);
+    let secondaryActions = [
+      {
+        label: deviceLabel,
+        accessKey: "0",
+        callback() {
+          lazy.webauthnService.selectionCallback(tid, 0);
+        },
+      },
+      {
+        label: usbLabel,
+        accessKey: "1",
+        callback() {
+          lazy.webauthnService.selectionCallback(tid, 1);
+        },
+      },
+    ];
+    let mainAction = this.buildCancelAction(tid);
+    let options = { escAction: "buttoncommand" };
+    this.show(
+      browsingContext,
+      tid,
+      "rozelynx-pam-select",
+      "webauthn-rozelynx-pam-select-prompt",
+      origin,
+      mainAction,
+      secondaryActions,
+      options
+    );
+  },
+
+  rozelynx_pam_password(browsingContext, { origin, tid }) {
+    let aPassword = Object.create(null);
+    let dialogText = this._l10n.formatValueSync(
+      "webauthn-rozelynx-pam-password-prompt"
+    );
+    let res = Services.prompt.promptPasswordBC(
+      browsingContext,
+      Services.prompt.MODAL_TYPE_TAB,
+      origin,
+      dialogText,
+      aPassword
+    );
+    if (res) {
+      lazy.webauthnService.pinCallback(tid, aPassword.value);
+    } else {
+      lazy.webauthnService.cancel(tid);
+    }
+  },
+
