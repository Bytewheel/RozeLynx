diff --git a/browser/components/translations/content/fullPageTranslationsPanel.js b/browser/components/translations/content/fullPageTranslationsPanel.js
--- a/browser/components/translations/content/fullPageTranslationsPanel.js
+++ b/browser/components/translations/content/fullPageTranslationsPanel.js
@@ -1287,11 +1287,50 @@
     const actor = TranslationsParent.getTranslationsActor(
       gBrowser.selectedBrowser
     );
-    const [sourceLanguage, sourceVariant] =
+    let [sourceLanguage, sourceVariant] =
       this.elements.fromMenuList.value.split(",");
-    const [targetLanguage, targetVariant] =
+    let [targetLanguage, targetVariant] =
       this.elements.toMenuList.value.split(",");
 
+    // RozeLynx: the panel can be shown and this handler can run before the
+    // page language detection has populated the language selectors - for
+    // example when the urlbar button is clicked right after the page load
+    // while the first Remote Settings records sync is still in flight, or
+    // while the page content language is still being identified.
+    // Upstream forwards the empty pair to the actor, whose translate()
+    // then returns without any user feedback - a dead Translate button.
+    // Resolve the pair from the actor's detected language tags instead,
+    // and only bail out with a visible error when nothing can be
+    // resolved at all.
+    if (!sourceLanguage || !targetLanguage) {
+      let langTags = actor.languageState?.detectedLanguages;
+      if (!langTags?.docLangTag || !langTags?.userLangTag) {
+        langTags = await actor.getLangTags().catch(() => null);
+      }
+      if (!sourceLanguage && langTags?.docLangTag) {
+        sourceLanguage = langTags.docLangTag;
+      }
+      if (!targetLanguage && langTags?.userLangTag) {
+        targetLanguage = langTags.userLangTag;
+      }
+    }
+
+    if (!sourceLanguage || !targetLanguage) {
+      this.console?.error(
+        "Unable to determine the source or target language for translation."
+      );
+      const { cancelButton, errorHintAction } = this.elements;
+      this.#showError({
+        message: "translations-panel-error-load-languages",
+        hint: "translations-panel-error-load-languages-hint",
+        actionText: "translations-panel-error-load-languages-hint-button",
+        actionCommand: () => this.#reloadLangList(actor),
+      });
+      cancelButton.hidden = false;
+      errorHintAction.disabled = false;
+      return;
+    }
+
     actor.translate(
       { sourceLanguage, targetLanguage, sourceVariant, targetVariant },
       false // reportAsAutoTranslate

