diff -ruN a/browser/themes/shared/aboutSessionRestore.css b/browser/themes/shared/aboutSessionRestore.css
--- a/browser/themes/shared/aboutSessionRestore.css	2026-09-27 15:33:25.559938128 -0400
+++ b/browser/themes/shared/aboutSessionRestore.css	2026-09-27 15:33:25.567821041 -0400
@@ -53,3 +53,69 @@
 .button-container {
   text-align: end;
 }
+
+/* RozeLynx: about:newtab-style header block above the restore controls.
+ * The .newtab-main subtree is a static copy of about:newtab's logo+search;
+ * activity-stream.css provides the base styles. */
+
+.newtab-main {
+  display: flex;
+  flex-direction: column;
+  justify-content: flex-start;
+  width: 100%;
+  /* Match about:newtab's only-search layout: the outer wrapper there has
+   * 48px padding and the search block another 48px top margin. */
+  margin-block-start: clamp(48px, 12vh, 128px);
+}
+
+.newtab-main .search-inner-wrapper {
+  height: 48px;
+}
+
+#rozelynx-search-form {
+  display: block;
+  width: 100%;
+  height: 100%;
+  margin: 0;
+}
+
+#rozelynx-search-input {
+  width: 100%;
+  height: 100%;
+  box-sizing: border-box;
+  border-radius: 8px;
+  border: 1px solid var(--newtab-border-color,
+                      color-mix(in srgb, currentColor 20%, transparent));
+  background-color: var(--newtab-background-color-secondary,
+                       var(--newtab-background-color, #f9f9fb));
+  color: var(--newtab-text-primary-color, currentColor);
+  padding: 0 16px;
+  font-size: 15px;
+  box-shadow: var(--newtab-search-shadow,
+                  0 1px 4px rgba(12, 12, 13, 0.1));
+}
+
+#rozelynx-search-input:focus-visible {
+  outline: 2px solid var(--newtab-primary-action-background, #8b5cf6);
+  outline-offset: -1px;
+}
+
+/* Keep the restore controls grouped below the search block. */
+body.activity-stream .container {
+  margin-block-start: var(--space-xlarge, 32px);
+  width: min(var(--in-content-container-max-width, 960px), 100%);
+}
+
+body.activity-stream .description-wrapper {
+  text-align: center;
+}
+
+#tabsToggle {
+  padding-inline-end: 45px;
+}
+
+/* Dark-mode parity: both pages respect system dark; ensure the restore
+ * controls stay readable over the activity-stream background. */
+body.activity-stream .container {
+  color: var(--newtab-text-primary-color, currentColor);
+}
