 ChromeUtils.defineESModuleGetters(this, {
   PlacesUIUtils: "moz-src:///browser/components/places/PlacesUIUtils.sys.mjs",
+  SearchService: "moz-src:///toolkit/components/search/SearchService.sys.mjs",
   SessionStore:
     "moz-src:///browser/components/sessionstore/SessionStore.sys.mjs",
 });
 
+// RozeLynx: mirror about:newtab theming. activity-stream.css switches its
+// variable set when the root element carries [lwt-newtab-brighttext]; on
+// the newtab that attribute is synced with the browser theme, here we track
+// the system color scheme (this build ships no separate toolbar theme UI).
+(function () {
+  var darkQuery = window.matchMedia("(prefers-color-scheme: dark)");
+  function applyTheme() {
+    if (darkQuery.matches) {
+      document.documentElement.setAttribute("lwt-newtab-brighttext", "");
+    } else {
+      document.documentElement.removeAttribute("lwt-newtab-brighttext");
+    }
+  }
+  applyTheme();
+  darkQuery.addEventListener("change", applyTheme);
+})();
+
