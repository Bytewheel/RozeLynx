+  // RozeLynx: the about:newtab-style search bar above starts a new session
+  // on Enter. Navigating away from this page discards the pending session,
+  // same as the old "Start New Session" button - the sessionstore backup on
+  // disk is left untouched. Do NOT call restoreSession() first.
+  var searchForm = document.getElementById("rozelynx-search-form");
+  var searchInput = document.getElementById("rozelynx-search-input");
+  if (searchForm && searchInput) {
+    searchForm.addEventListener("submit", function (event) {
+      event.preventDefault();
+      var query = searchInput.value.trim();
+      if (!query) {
+        return;
+      }
+      try {
+        // FF153: the search service is an ES module (SearchService above);
+        // Services.search does not exist on this page.
+        var submission = SearchService.defaultEngine.getSubmission(query);
+        var browserWin = getBrowserWindow();
+        var loadOptions = {
+          triggeringPrincipal:
+            Services.scriptSecurityManager.createNullPrincipal({}),
+        };
+        if (submission.postData) {
+          loadOptions.postData = submission.postData;
+        }
+        browserWin.gBrowser.loadURI(
+          Services.io.newURI(submission.uri.spec),
+          loadOptions
+        );
+      } catch (e) {
+        // Fall back to the normal new-session behavior on any search error.
+        startNewSession();
+      }
+    });
+  }
+
   // the crashed session state is kept inside a textbox so that SessionStore picks it up
